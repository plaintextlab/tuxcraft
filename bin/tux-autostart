#!/usr/bin/env bash
# tux-autostart i3|sway — everything a session needs, started once. Called from the WM config.
session=${1:-i3}
log="$HOME/.local/state/tuxcraft/autostart.log"; mkdir -p "${log%/*}"; exec >>"$log" 2>&1
echo "--- $(date) $session"

# Logged in by itself at boot (tux-autologin): lock the screen before anything else starts, so
# the desktop loads behind the lock while the password is typed. If no lock screen shows up
# within 10 s, end the session rather than leave it open (the normal login screen follows).
if [[ ${TUX_LOCK_AT_START:-} == 1 ]]; then
  tux-lock &
  (
    for _ in $(seq 20); do
      sleep 0.5
      pgrep -u "$UID" -x i3lock >/dev/null || pgrep -u "$UID" -x swaylock >/dev/null && exit 0
    done
    echo "tux-autostart: no lock screen after autologin; ending the session"
    if [[ $session == sway ]]; then swaymsg exit; else i3-msg exit; fi
  ) &
fi
STATE="$HOME/.config/tuxcraft/state"; IDLE_LOCK_MIN=10
# shellcheck source=/dev/null
[[ -f $STATE ]] && . "$STATE"

once() { pgrep -u "$UID" -x "$1" >/dev/null || { "$@" & }; }

# Environment for D-Bus activated services (portals, keyring, notifications)
vars="DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XAUTHORITY QT_QPA_PLATFORMTHEME"
if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  dbus-update-activation-environment --systemd $vars
  systemctl --user restart xdg-desktop-portal.service 2>/dev/null &
else
  # shellcheck disable=SC2086
  dbus-update-activation-environment $vars
  # No systemd user units (Void): start the audio stack ourselves. Nothing stops it at logout,
  # so a quick re-login used to find the last session's pipewire (bound to a dead D-Bus bus)
  # and keep it. tux-pipewire replaces it with a fresh, supervised one.
  tux-pipewire start
fi

once tux-polkit
eval "$(gnome-keyring-daemon --start --components=secrets 2>/dev/null)" || true
once dunst
# A new session starts with plain gamma: forget dimming and night light left from the last one.
rm -f "${XDG_RUNTIME_DIR:-/tmp}/tux-dim" "${XDG_RUNTIME_DIR:-/tmp}/tux-nightlight"
# tux-gamevm: say so if a drive shared with Windows came back read-only.
[[ -s /run/tux-gamevm.notice ]] && { sleep 3; notify-send -u critical "Gaming VM" "$(cat /run/tux-gamevm.notice)"; } &
# Volume popup for changes made anywhere (bar scroll, mixers), not only the volume keys.
pgrep -u "$UID" -f 'tux-osd watch' >/dev/null || { tux-osd watch & }
# Put apps that hide and re-show their main window (Resolve's Cinema Viewer) back in their tiling slot.
pgrep -u "$UID" -f '^python3 .*/tux-winslot' >/dev/null || { tux-winslot & }
# Thumbnails for the workspace overview (Super+O).
tux-overview watch &   # exits at once if one is already running
# Music daemon for rmpc (folder: tux-music folder).
command -v mpd >/dev/null && tux-music start
# First login with printing set up but no printer yet: add the ones found on the network / USB.
command -v lpadmin >/dev/null && { sleep 15; tux-printer --auto; } &
once nm-applet --indicator
command -v udiskie >/dev/null && once udiskie --smart-tray --notify
tux-theme-gsettings 2>/dev/null || true
# Firefox profiles made since the last theme change (e.g. the first start) get the theme too.
command -v tux-firefox >/dev/null && { tux-firefox apply & }
tux-wallpaper restore &
# Fast start for browser, terminal and file manager (backs off when memory is tight or a game runs).
tux-warm daemon "$session" &   # exits at once if one is already running

idle=$(( ${IDLE_LOCK_MIN:-10} * 60 ))
case $session in
  i3)
    once xsettingsd
    command -v xsetroot >/dev/null && xsetroot -cursor_name left_ptr   # desktop cursor = themed one
    # NVIDIA queues frames ahead by default, so compositor animations trail a little; one
    # frame in flight keeps them smooth and in step with the screen.
    if command -v picom >/dev/null; then
      if [[ -d /proc/driver/nvidia ]]; then __GL_MaxFramesAllowed=1 once picom; else once picom; fi
    fi
    command -v autorandr >/dev/null && autorandr --change --default default >/dev/null 2>&1
    command -v numlockx >/dev/null && numlockx on
    # Key repeat: start after 220 ms, 40 per second (X's default, 660 ms / 25, feels sluggish).
    xset r rate 220 40
    # Touchpad off while typing, for longer than libinput's own guard (palm between words).
    tux-dwt start
    if (( idle > 0 )); then
      xset s "$idle" "$idle"; xset dpms $((idle + 300)) $((idle + 300)) $((idle + 300))
      once xss-lock --transfer-sleep-lock -- tux-lock --now
    else
      xset s off -dpms
    fi
    if command -v copyq >/dev/null; then once copyq
    elif flatpak info com.github.hluk.copyq >/dev/null 2>&1; then pgrep -f hluk.copyq >/dev/null || flatpak run com.github.hluk.copyq &
    fi
    "$HOME/.config/polybar/launch.sh"
    ;;
  sway)
    once waybar
    command -v kanshi >/dev/null && once kanshi
    once wl-paste --watch cliphist store
    if (( idle > 0 )); then
      once swayidle -w timeout "$idle" 'tux-lock --now' \
        timeout $((idle + 300)) 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
        before-sleep 'tux-lock --now'
    fi
    ;;
esac
# XDG autostart entries (~/.config/autostart and /etc/xdg/autostart). Those this script already
# started get a Hidden=true override, or dex starts a second picom / polkit agent / nm-applet
# that only fails noisily ("Another composite manager is already running").
if command -v dex >/dev/null; then
  mkdir -p "$HOME/.config/autostart"
  for a in picom compton polkit-mate-authentication-agent-1 polkit-gnome-authentication-agent-1 \
           lxpolkit nm-applet autorandr udiskie copyq com.github.hluk.copyq; do
    f=$HOME/.config/autostart/$a.desktop
    [[ -e $f || ! -e /etc/xdg/autostart/$a.desktop ]] && continue
    printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n# tux-autostart starts this itself\n' "$a" >"$f"
  done
  dex --autostart --environment "$session" &
fi
