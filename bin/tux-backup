#!/usr/bin/env bash
# tux-backup [mountpoint] — real backups on another drive. Snapshots live on the same disk,
# so they do not survive a dead SSD; this does.
#   btrfs target: incremental `btrfs send/receive` of / and /home (fast, exact, browsable)
#   other fs:     rsync of /home and /etc with hard-linked daily folders
# Keeps the newest $KEEP backups on the target (default 14).
set -euo pipefail
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
KEEP=${KEEP:-14}
host=$(hostname)
ts=$(date +%Y-%m-%d_%H%M%S)

dest_mp=${1:-}
if [[ -z $dest_mp ]]; then
  rootdev=$(findmnt -no SOURCE / | sed 's/\[.*\]//')
  mapfile -t cands < <(findmnt -rn -o TARGET,SOURCE,FSTYPE | awk -v r="$rootdev" '$2!~r && $1~"^/(run/media|media|mnt)/" {print $1" ("$3")"}')
  ((${#cands[@]})) || { echo "Plug in and mount a backup drive (e.g. via udiskie), then run again,"; echo "or pass its mountpoint: tux-backup /run/media/$SUDO_USER/BACKUP"; exit 1; }
  echo "Backup targets:"; for i in "${!cands[@]}"; do echo "  $((i+1))) ${cands[i]}"; done
  read -r -p "Choose [1]: " i; i=${i:-1}; dest_mp=${cands[i-1]%% (*}
fi
[[ -d $dest_mp ]] || { echo "Not a directory: $dest_mp"; exit 1; }
dest="$dest_mp/tuxcraft-backups/$host"; mkdir -p "$dest"

if [[ $(findmnt -no FSTYPE --target "$dest_mp") == btrfs && $(findmnt -no FSTYPE /) == btrfs ]]; then
  top=$(mktemp -d /run/tux-top.XXXX)
  mount -o subvolid=5 "$(findmnt -no SOURCE / | sed 's/\[.*\]//')" "$top"
  trap 'umount "$top"; rmdir "$top"' EXIT
  mkdir -p "$top/.tuxbackup"
  for pair in "@:root" "@home:home"; do
    sv=${pair%%:*} name=${pair##*:}
    [[ -d $top/$sv ]] || continue
    new="$top/.tuxbackup/$name.$ts"
    btrfs subvolume snapshot -r "$top/$sv" "$new" >/dev/null; sync
    parent=''
    for p in $(ls -d "$top/.tuxbackup/$name".* 2>/dev/null | sort -r); do
      [[ $p == "$new" ]] && continue
      [[ -d $dest/$(basename "$p") ]] && { parent=$p; break; }
    done
    echo "→ $name ${parent:+(incremental from $(basename "$parent"))}"
    if [[ -n $parent ]]; then btrfs send -q -p "$parent" "$new" | btrfs receive "$dest"
    else btrfs send -q "$new" | btrfs receive "$dest"; fi
    # local: keep only the newest one (it is the parent for next time)
    ls -d "$top/.tuxbackup/$name".* | sort -r | tail -n +2 | xargs -r -n1 btrfs subvolume delete >/dev/null
    ls -d "$dest/$name".* | sort -r | tail -n +$((KEEP + 1)) | xargs -r -n1 btrfs subvolume delete >/dev/null
  done
else
  echo "Target is not btrfs: using rsync (only /home and /etc)."
  last=$(ls -d "$dest"/20* 2>/dev/null | sort | tail -n1 || true)
  mkdir -p "$dest/$ts"
  rsync -aHAX --info=progress2 --delete ${last:+--link-dest="$last"} \
    --exclude='.cache/' --exclude='.local/share/Trash/' --exclude='.snapshots/' /home /etc "$dest/$ts/"
  ls -d "$dest"/20* | sort -r | tail -n +$((KEEP + 1)) | xargs -r rm -rf
fi
echo "Backup finished: $dest"
