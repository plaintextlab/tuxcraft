#!/usr/bin/env bash
# tux-capture region|screen|menu|stop — screenshots and recordings (from debi3n
# rofi-screen-capture.sh), for X11 (maim/slop/xclip) and Wayland (grim/slurp/wl-copy).
SHOTS="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
VIDS="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Screen Captures"
AUDIO="$HOME/Music/Voice Recordings"
PID=${XDG_RUNTIME_DIR:-/tmp}/tux-record.pid INFO=${XDG_RUNTIME_DIR:-/tmp}/tux-record.file
LOG=${XDG_RUNTIME_DIR:-/tmp}/tux-record.log
mkdir -p "$SHOTS" "$VIDS" "$AUDIO"
ts=$(date +%Y-%m-%d_%H-%M-%S)
wl() { [[ -n ${WAYLAND_DISPLAY:-} ]]; }

copy_png() { if wl; then wl-copy -t image/png <"$1"; else xclip -selection clipboard -t image/png <"$1"; fi; }

shot() {  # shot region|screen
  local f="$SHOTS/${1}_$ts.png"
  if wl; then
    if [[ $1 == region ]]; then grim -g "$(slurp)" "$f" || exit 1; else grim "$f"; fi
  else
    if [[ $1 == region ]]; then maim -s -u "$f" || exit 1; else sleep 0.2; maim -u "$f"; fi
  fi
  copy_png "$f"
  notify-send -a capture -i "$f" "Screenshot saved + copied" "${f/#$HOME/\~}"
}

# PID of the running recorder, or nothing. Checks the process name, so a stale pid file
# left by a crash never makes us signal some unrelated process that reused the number.
recorder_pid() {
  local p; p=$(cat "$PID" 2>/dev/null) || return 1
  [[ $p =~ ^[0-9]+$ ]] && [[ $(cat "/proc/$p/comm" 2>/dev/null) =~ ^(ffmpeg|wf-recorder)$ ]] && echo "$p"
}

# H.264 encoder: NVENC/VAAPI keep the CPU free (games!), libx264 is the fallback.
video_codec() {
  if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' h264_nvenc ' &&
     ffmpeg -nostdin -v error -f lavfi -i color=size=256x256:duration=0.1 -c:v h264_nvenc -f null - 2>/dev/null; then
    echo "-c:v h264_nvenc -preset p4 -cq 23"
  else
    echo "-c:v libx264 -preset ultrafast -crf 23"
  fi
}

record() {  # record screen|mic
  recorder_pid >/dev/null && { notify-send "Already recording" "Super+Shift+Print stops it"; exit 1; }
  local f mon mic
  mon="$(pactl get-default-sink 2>/dev/null).monitor"; mic=$(pactl get-default-source 2>/dev/null)
  if [[ $1 == mic ]]; then
    f="$AUDIO/mic_$ts.mp3"
    ffmpeg -nostdin -y -f pulse -i "$mic" -c:a libmp3lame -q:a 2 "$f" >"$LOG" 2>&1 &
  elif wl; then
    f="$VIDS/screen_$ts.mp4"
    if command -v wf-recorder >/dev/null; then
      wf-recorder --audio="$mon" -f "$f" >"$LOG" 2>&1 &
    else
      notify-send "Install wf-recorder for screen recording on Wayland"; exit 1
    fi
  else
    f="$VIDS/screen_$ts.mp4"
    # Whole X screen (all monitors), not just the first monitor's mode.
    local res; res=$(xrandr --current | awk '/^Screen/{for(i=1;i<=NF;i++) if($i=="current"){print $(i+1)"x"$(i+3); exit}}' | tr -d ,)
    # shellcheck disable=SC2046
    ffmpeg -nostdin -y -f x11grab -framerate 30 -video_size "$res" -i "${DISPLAY}" \
      -f pulse -i "$mon" -f pulse -i "$mic" \
      -filter_complex "[1:a][2:a]amix=inputs=2:duration=longest[a]" -map 0:v -map "[a]" \
      $(video_codec) -pix_fmt yuv420p -c:a aac -b:a 160k "$f" >"$LOG" 2>&1 &
  fi
  echo $! >"$PID"; echo "$f" >"$INFO"
  sleep 1
  if ! recorder_pid >/dev/null; then
    rm -f "$PID" "$INFO" "$f"
    notify-send -u critical -a capture "Recording failed to start" "$(tail -n 2 "$LOG")"
    exit 1
  fi
  notify-send -a capture "● Recording" "Super+Shift+Print to stop"
}

stop() {
  local p f; p=$(recorder_pid) || { rm -f "$PID" "$INFO"; notify-send "Nothing is recording"; exit 0; }
  f=$(cat "$INFO" 2>/dev/null)
  kill -INT "$p" 2>/dev/null
  # Wait until the file is finalised (the MP4 index is written last) before saying it is saved.
  for _ in $(seq 100); do kill -0 "$p" 2>/dev/null || break; sleep 0.1; done
  rm -f "$PID" "$INFO"
  notify-send -a capture "Recording saved" "${f/#$HOME/\~}"
}

case ${1:-menu} in
  region|screen) shot "$1" ;;
  stop) stop ;;
  menu)
    c=$(printf '󰩭  Region screenshot\n󰹑  Full screenshot\n󰕧  Record screen\n󰍬  Record microphone\n󰓛  Stop recording\n' | tux-menu capture) || exit 0
    case $c in
      *Region*) sleep 0.2; shot region ;; *Full*) shot screen ;;
      *screen) record screen ;; *microphone) record mic ;; *Stop*) stop ;;
    esac ;;
esac
