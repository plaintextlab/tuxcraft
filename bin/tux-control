#!/usr/bin/env bash
# System menu (Super+Escape): every tuxcraft knob in one place.
t="alacritty --class tux-float -e" T="alacritty --class tux-float-big -e"
vm='' gpu=''; [[ -f /etc/tuxcraft/gamevm.conf ]] && vm="󰊴  Gaming VM (Windows)"
# Hybrid laptops: the dGPU serves either Linux games or the VM (switch takes a logout).
if grep -qs '^MODE=hybrid' /etc/tuxcraft/gamevm.conf; then
  if [[ $(cat /etc/tuxcraft/gamevm-gpu-mode 2>/dev/null) == linux ]]; then gpu="󰢮  GPU: use for gaming VM"; else gpu="󰢮  GPU: use for Linux games"; fi
fi
c=$(printf '%s\n' ${vm:+"$vm"} ${gpu:+"$gpu"} \
  "󰏘  Colour theme" "󰛖  Font" "󰸉  Wallpaper" "󰚰  Update system (sysup)" "󰆓  Snapshots" \
  "󰁯  Back up to external drive" "󰖩  Network" "󰂯  Bluetooth" "󰕾  Audio mixer" "󰓃  Audio output" \
  "󰾅  Power profile" "󰖔  Night light toggle" "󰹑  Compositor on/off (i3)" "󰍹  Displays" \
  "󰌌  Keybindings" "󰋼  System info" "󰐥  Power menu" | tux-menu system) || exit 0
case $c in
  *"Gaming VM"*) tux-gamevm start ;;
  *"GPU: use for"*)
    want=vm; [[ $c == *"Linux games"* ]] && want=linux
    if out=$(sudo -n /usr/local/bin/tux-gamevm gpu "$want" 2>&1); then
      a=$(printf '%s\n' "󰍃  Log out now" "󰜺  Later" | tux-menu "GPU switch: log out to apply") || exit 0
      [[ $a == *"Log out"* ]] && { if [[ -n ${SWAYSOCK:-} ]]; then swaymsg exit; else i3-msg exit; fi; }
    else notify-send -u critical "GPU switch" "$out"; fi ;;
  *theme) tux-theme --menu ;;
  *Font) tux-font --menu ;;
  *Wallpaper) tux-wallpaper --menu ;;
  *sysup*) $T sysup --pause ;;
  *Snapshots) $T tux-snap ;;
  *external*) $T bash -c 'tux-backup; read -n1 -rp "Press any key"' ;;
  *Network) $t nmtui ;;
  *Bluetooth) $t bluetui ;;
  *mixer) $t tux-mixer ;;
  *output) tux-audio output ;;
  *profile) tux-powerprofile ;;
  *Night*) tux-nightlight toggle ;;
  *Compositor*) pgrep -x picom >/dev/null && pkill -x picom || setsid -f picom ;;
  *Displays) if [[ -n ${WAYLAND_DISPLAY:-} ]]; then $t bash -c 'swaymsg -t get_outputs; echo; echo "Edit ~/.config/kanshi/config to persist."; read -n1'; else arandr; fi ;;
  *Keybindings) tux-keys ;;
  *info) $t bash -c 'fastfetch; read -n1 -rp ""' ;;
  *menu) tux-power ;;
esac
