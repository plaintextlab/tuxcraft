#!/usr/bin/env bash
# tux-dwmbar BLOCK — one block of the dwm session's status bar, run by dwmblocks (src/dwmblocks,
# blocks.def.h). The same blocks as tuxcraft's polybar, in BreadOnPenguins' style (glyph + value),
# and the same clicks: dwmblocks runs the block again with BLOCK_BUTTON set (1 left, 2 middle,
# 3 right, 4/5 scroll).
#   tux-dwmbar music|music-prev|music-toggle|music-next|collapse|cpu|memory|gpu|updates|bluetooth|
#              volume|network|battery|power|record|clock
# collapse: polybar's chevron (collapse.sh). CPU, memory and GPU start hidden; click 󰅁 to show
# them, 󰅂 to hide them again (Windows tray-overflow style).
#   tux-dwmbar refresh [BLOCK]   update the bar now (every block, or one)
# Slow blocks (updates, Bluetooth) print what they found last time and look again in the
# background, so dwmblocks never waits for them.
set -uo pipefail
RT=${XDG_RUNTIME_DIR:-/tmp}/tux-dwmbar-$UID
POLY=$HOME/.config/polybar/scripts   # the polybar block scripts, shared (their colour tags are dropped)
T=tux-term   # not $TERMINAL: the --class / -e arguments below are tux-term's (it picks the terminal)
BTN=${BLOCK_BUTTON:-}
mkdir -p "$RT"

# Signal numbers, as in blocks.def.h (10 is left out: it is a newline).
declare -A SIG=([music]=1 [music-prev]=14 [music-toggle]=15 [music-next]=16 [collapse]=17 [cpu]=2 [memory]=3 [gpu]=4 [updates]=5 [bluetooth]=6 [volume]=7
                [network]=8 [battery]=9 [power]=11 [record]=12 [clock]=13)

# Colours: the active theme's palette (tux-theme writes colors.sh and then refreshes the bar), read
# every time a block is drawn, so the icons always match the theme. Only the icons get a colour.
# shellcheck source=/dev/null
. "${XDG_CONFIG_HOME:-$HOME/.config}/tuxcraft/colors.sh" 2>/dev/null
declare -A COLOR=([music]='' [music-prev]=${magenta:-} [music-toggle]=${magenta:-} [music-next]=${magenta:-}
                  [collapse]=${muted:-} [cpu]=${blue:-} [memory]=${green:-} [gpu]=${cyan:-}
                  [updates]=${yellow:-} [bluetooth]=${blue:-} [volume]=${muted:-} [network]=${cyan:-}
                  [battery]=${green:-} [power]=${orange:-} [record]=${red:-} [clock]=${accent:-})

# polybar colour tags (%{F#rrggbb} ... %{F-}) become dwm's (^c#rrggbb^ ... ^d^); other tags go.
strip() { sed -E 's/%\{F(#[0-9A-Fa-f]{6})\}/^c\1^/g; s/%\{F-\}/^d^/g; s/%\{[^}]*\}//g; s/[[:space:]]+$//' | head -n1; }
GLYPH=$'[\x80-\xff]'   # any byte of a multibyte (UTF-8) character: the Nerd Font icons
# Colour a block's icons (the non-ASCII glyphs), unless the script coloured them itself.
paint() {  # paint COLOR
  local l; IFS= read -r l || return 0
  if [[ -z $1 || $l == *'^c'* ]]; then printf '%s\n' "$l"
  else printf '%s\n' "$l" | LC_ALL=C sed -E "s/($GLYPH+)/^c$1^\\1^d^/g"; fi
}
refresh() {  # refresh [BLOCK]
  local b
  if [[ -n ${1:-} ]]; then pkill -RTMIN+"${SIG[$1]}" -u "$UID" -x dwmblocks
  else for b in "${SIG[@]}"; do pkill -RTMIN+"$b" -u "$UID" -x dwmblocks; done; fi
  return 0
}
# After a click: let the change happen (volume, player), then redraw this block.
later() { (sleep 0.3; refresh "$1") >/dev/null 2>&1 & }
float() { setsid -f "$T" --class tux-float -e "$@" >/dev/null 2>&1; }
floatbig() { setsid -f "$T" --class tux-float-big -e "$@" >/dev/null 2>&1; }

# Slow blocks: the last result now, a fresh one in the background (at most every N seconds).
cached() {  # cached NAME SECONDS command...
  local name=$1 every=$2 f=$RT/$1 now; shift 2
  now=$(date +%s)
  if [[ ! -f $f.stamp ]] || (( now - $(cat "$f.stamp") >= every )); then
    echo "$now" >"$f.stamp"
    ( "$@" 2>/dev/null | strip >"$f.new"; mv "$f.new" "$f"; refresh "$name" ) >/dev/null 2>&1 &
  fi
  cat "$f" 2>/dev/null
}

# Music, as polybar's (tux-nowplaying): 󰝚 + previous / play-pause / next buttons + "Artist – Title",
# for the player tux-nowplaying picks (playing first, then one you paused). Four blocks, so each
# button is clickable; they ask tux-nowplaying once a second between them (cached).
music_state() {
  local f=$RT/music-state now
  now=$(date +%s)
  if [[ ! -f $f ]] || (( now - $(stat -c %Y "$f") >= 1 )) || [[ -n $BTN ]]; then
    tux-nowplaying status >"$f.new" 2>/dev/null; mv "$f.new" "$f"
  fi
  IFS='|' read -r PLAYER STATUS TEXT <"$f" 2>/dev/null || PLAYER=''
}
music_ctl() {  # music_ctl ACTION: on the shown player, then redraw the music blocks
  music_state
  [[ -n $PLAYER ]] && tux-nowplaying "ctl-$PLAYER" "$1"
  rm -f "$RT/music-state"
  (sleep 0.3; refresh music; refresh music-toggle) >/dev/null 2>&1 &
}
block_music_prev() {
  [[ $BTN == 1 ]] && music_ctl previous
  music_state; [[ -n $PLAYER ]] && echo '󰝚 󰒮'
}
block_music_toggle() {
  [[ $BTN == 1 ]] && music_ctl play-pause
  music_state; [[ -n $PLAYER ]] || return 0
  if [[ $STATUS == Playing ]]; then echo '󰏤'; else echo '󰐊'; fi
}
block_music_next() {
  [[ $BTN == 1 ]] && music_ctl next
  music_state; [[ -n $PLAYER ]] && echo '󰒭'
}
block_music() {
  case $BTN in
    1) music_ctl play-pause ;;
    3|5) music_ctl next ;;
    4) music_ctl previous ;;
  esac
  music_state; [[ -n $PLAYER ]] || return 0
  local text=$TEXT
  ((${#text} > 32)) && text="${text:0:31}…"
  printf '%s\n' "$text"
}

# The chevron: CPU, memory and GPU hidden (󰅁, the default) or shown (󰅂).
expanded() { [[ -e $RT/expanded ]]; }
block_collapse() {
  if [[ $BTN == 1 ]]; then
    if expanded; then rm -f "$RT/expanded"; else : >"$RT/expanded"; fi
    (sleep 0.1; refresh collapse; refresh cpu; refresh memory; refresh gpu) >/dev/null 2>&1 &
  fi
  if expanded; then echo '󰅂'; else echo '󰅁'; fi
}

block_cpu() {
  [[ -n $BTN ]] && floatbig btop
  local _ u n s i w q sq st total idle pt=0 pi=0
  read -r _ u n s i w q sq st _ </proc/stat
  total=$((u + n + s + i + w + q + sq + st)) idle=$((i + w))
  [[ -f $RT/cpu ]] && read -r pt pi <"$RT/cpu"
  echo "$total $idle" >"$RT/cpu"
  expanded || return 0
  (( total > pt )) && printf '󰻠 %d%%\n' $(( 100 * ((total - pt) - (idle - pi)) / (total - pt) ))
}

block_memory() {
  [[ -n $BTN ]] && floatbig btop
  expanded || return 0
  awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2}
       END { if (t) printf "󰍛 %d%% %.1fG free\n", (t - a) * 100 / t, a / 1048576 }' /proc/meminfo
}

block_gpu() { [[ -n $BTN ]] && floatbig btop; expanded || return 0; "$POLY/gpu.sh" 2>/dev/null | strip; }

block_updates() {
  [[ $BTN == 1 ]] && floatbig sysup --pause
  cached updates 1800 tux-updates
}

block_bluetooth() {
  [[ $BTN == 1 ]] && float bluetui
  cached bluetooth 10 tux-btbattery --plain
}

block_volume() {
  case $BTN in
    1) "$POLY/volume.sh" mute; later volume ;;
    2) tux-audio output & ;;
    3) float tux-mixer ;;
    4) "$POLY/volume.sh" up; later volume ;;
    5) "$POLY/volume.sh" down; later volume ;;
  esac
  "$POLY/volume.sh" 2>/dev/null | strip
}

block_network() {
  case $BTN in 1) float tux-net ;; 3) float tux-net nmtui ;; esac
  local o; o=$(tux-netinfo --plain 2>/dev/null | strip)
  [[ $o == 󰖪* && -n ${muted:-} ]] && o="^c$muted^$o^d^"   # offline: greyed out, as in polybar
  [[ -n $o ]] && printf '%s\n' "$o"
}

block_battery() { "$POLY/battery.sh" 2>/dev/null | strip; }

block_power() {
  [[ $BTN == 1 ]] && { tux-powerprofile & }
  "$POLY/powerprofile.sh" 2>/dev/null | strip
}

block_record() {
  [[ $BTN == 1 ]] && { tux-capture stop; later record; }
  tux-capture status 2>/dev/null | strip
}

# 12-hour clock; left click: full date, right click: calendar (as in polybar).
block_clock() {
  case $BTN in
    1) if [[ -e $RT/date-long ]]; then rm -f "$RT/date-long"; else : >"$RT/date-long"; fi; later clock ;;
    3) float calcurse ;;
  esac
  # (A trailing space: some room before the screen edge, as in her bar.)
  if [[ -e $RT/date-long ]]; then date '+󰃭 %a %d %b %Y  %I:%M:%S %p '; else date '+󰥔 %I:%M %p '; fi
}

case ${1:-} in
  refresh) refresh "${2:-}" ;;
  music|collapse|cpu|memory|gpu|updates|bluetooth|volume|network|battery|power|record|clock|music-prev|music-toggle|music-next)
    c=${COLOR[$1]}
    "block_${1//-/_}" | paint "$c" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
