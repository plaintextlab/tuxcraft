#!/usr/bin/env bash
# tux-firefox [apply|profiles]  — Firefox in the tuxcraft colours and fonts.
#   apply      write the current theme and fonts into every Firefox profile (tux-theme runs this)
#   profiles   list the profiles found
# Covers Firefox (~/.config/mozilla/firefox and ~/.mozilla/firefox), Flatpak Firefox and
# LibreWolf. Per profile it writes:
#   chrome/tuxcraft.css           toolbar, tabs, address bar, menus, panels, sidebar
#   chrome/tuxcraft-content.css   new-tab / home page and blank pages
#   chrome/userChrome.css, userContent.css   @import the two above (your own rules stay)
#   user.js                       a "tuxcraft" block: enables userChrome, dark/light, fonts
# Firefox reads these when it starts: restart it to see a new theme.
# Settings in ~/.config/tuxcraft/state:
#   FIREFOX_THEME=no       leave Firefox alone (removes the imports and the block)
#   FIREFOX_CORNERS=round  keep Firefox's rounded corners (default: square)
#   FIREFOX_FONTS=site     let websites use their own fonts (default: your fonts on every site)
set -uo pipefail
SHARE=${TUX_SHARE:-/usr/share/tuxcraft}
CONF="$HOME/.config/tuxcraft"; STATE="$CONF/state"
THEME=gruvbox FONT="JetBrainsMono Nerd Font" TERM_FONT="JetBrainsMono Nerd Font"
FIREFOX_THEME=yes FIREFOX_CORNERS=square FIREFOX_FONTS=all
# shellcheck source=/dev/null
[[ -f $STATE ]] && . "$STATE"

ROOTS=(
  "$HOME/.config/mozilla/firefox" "$HOME/.mozilla/firefox"
  "$HOME/.var/app/org.mozilla.firefox/config/mozilla/firefox" "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
  "$HOME/.librewolf" "$HOME/.config/librewolf/librewolf" "$HOME/.var/app/io.gitlab.librewolf-community/.librewolf"
)

# Every profile directory named in a profiles.ini (relative or absolute paths).
profiles() {
  local root
  for root in "${ROOTS[@]}"; do
    [[ -f $root/profiles.ini ]] || continue
    awk -F= -v root="$root" '
      /^\[/ { if (path != "") print (rel ? root "/" path : path); path = ""; rel = 1 }
      $1 == "Path" { path = substr($0, 6) }
      $1 == "IsRelative" { rel = ($2 == 1) }
      END { if (path != "") print (rel ? root "/" path : path) }' "$root/profiles.ini"
  done | while IFS= read -r d; do [[ -d $d ]] && echo "$d"; done | sort -u
}

theme_file() {
  local f
  for f in "$CONF/themes/$1.theme" "$SHARE/themes/$1.theme"; do [[ -f $f ]] && { echo "$f"; return 0; }; done
  return 1
}

chrome_css() {
  cat <<EOF
/* tuxcraft: generated by tux-firefox for the $name theme. Changes here are overwritten;
   put your own rules in userChrome.css after the @import line. */
:root {
  --tux-bg: $bg; --tux-bg-dark: $bg_dark; --tux-bg-alt: $bg_alt; --tux-bg-hl: $bg_hl;
  --tux-fg: $fg; --tux-fg-dim: $fg_dim; --tux-muted: $muted;
  --tux-accent: $accent; --tux-accent-fg: $accent_fg; --tux-red: $red;

  /* tab strip and window frame */
  --lwt-accent-color: var(--tux-bg-dark) !important;
  --lwt-accent-color-inactive: var(--tux-bg-dark) !important;
  --lwt-text-color: var(--tux-fg-dim) !important;
  --toolbox-bgcolor: var(--tux-bg-dark) !important;
  --toolbox-bgcolor-inactive: var(--tux-bg-dark) !important;
  --toolbox-textcolor: var(--tux-fg-dim) !important;
  --toolbox-textcolor-inactive: var(--tux-muted) !important;
  --tab-selected-bgcolor: var(--tux-bg) !important;
  --tab-selected-textcolor: var(--tux-fg) !important;
  --tab-hover-background-color: var(--tux-bg-alt) !important;
  --tab-loading-fill: var(--tux-accent) !important;
  --tab-attention-icon-color: var(--tux-accent) !important;
  --lwt-tab-line-color: var(--tux-accent) !important;

  /* toolbars and buttons */
  --toolbar-bgcolor: var(--tux-bg) !important;
  --toolbar-color: var(--tux-fg) !important;
  --toolbarbutton-icon-fill: var(--tux-fg) !important;
  --toolbarbutton-icon-fill-attention: var(--tux-accent) !important;
  --toolbarbutton-hover-background: var(--tux-bg-alt) !important;
  --toolbarbutton-active-background: var(--tux-bg-hl) !important;
  --toolbarseparator-color: var(--tux-bg-hl) !important;
  --chrome-content-separator-color: var(--tux-bg-dark) !important;
  --focus-outline-color: var(--tux-accent) !important;
  --button-primary-bgcolor: var(--tux-accent) !important;
  --button-primary-color: var(--tux-accent-fg) !important;

  /* address bar and its results */
  --toolbar-field-background-color: var(--tux-bg-alt) !important;
  --toolbar-field-color: var(--tux-fg) !important;
  --toolbar-field-border-color: transparent !important;
  --toolbar-field-focus-background-color: var(--tux-bg-dark) !important;
  --toolbar-field-focus-color: var(--tux-fg) !important;
  --toolbar-field-focus-border-color: var(--tux-accent) !important;
  --urlbar-box-bgcolor: var(--tux-bg-hl) !important;
  --urlbar-box-text-color: var(--tux-fg) !important;
  --urlbarView-highlight-background: var(--tux-accent) !important;
  --urlbarView-highlight-color: var(--tux-accent-fg) !important;
  --urlbarView-separator-color: var(--tux-bg-hl) !important;
  --urlbarView-action-color: var(--tux-accent) !important;
  --lwt-toolbar-field-highlight: var(--tux-accent) !important;
  --lwt-toolbar-field-highlight-text: var(--tux-accent-fg) !important;

  /* menus, panels, popups, sidebar */
  --arrowpanel-background: var(--tux-bg) !important;
  --arrowpanel-color: var(--tux-fg) !important;
  --arrowpanel-border-color: var(--tux-bg-hl) !important;
  --panel-separator-color: var(--tux-bg-hl) !important;
  --panel-item-hover-bgcolor: var(--tux-bg-alt) !important;
  --menu-background-color: var(--tux-bg) !important;
  --menu-color: var(--tux-fg) !important;
  --menu-border-color: var(--tux-bg-hl) !important;
  --menuitem-hover-background-color: var(--tux-bg-alt) !important;
  --menu-disabled-color: var(--tux-muted) !important;
  --sidebar-background-color: var(--tux-bg-dark) !important;
  --sidebar-text-color: var(--tux-fg) !important;
  --sidebar-border-color: var(--tux-bg-hl) !important;
  --lwt-sidebar-background-color: var(--tux-bg-dark) !important;
  --lwt-sidebar-text-color: var(--tux-fg) !important;
  --tabpanel-background-color: var(--tux-bg) !important;

  font-family: "$FONT", sans-serif !important;
}
#navigator-toolbox, #TabsToolbar, #titlebar { background-color: var(--tux-bg-dark) !important; color: var(--tux-fg-dim) !important; }
#nav-bar, #PersonalToolbar, #FindToolbar, findbar { background-color: var(--tux-bg) !important; color: var(--tux-fg) !important; }
.tab-background:is([selected], [multiselected]) { background: var(--tux-bg) !important; }
.tabbrowser-tab[selected] .tab-label { color: var(--tux-fg) !important; }
#tabbrowser-tabpanels, #sidebar-box { background-color: var(--tux-bg) !important; }
#urlbar-background, #searchbar { background-color: var(--tux-bg-alt) !important; }
#urlbar:is([focused], [open]) > #urlbar-background { background-color: var(--tux-bg-dark) !important; }
#urlbar, #urlbar-input, #searchbar { color: var(--tux-fg) !important; }
menupopup, panel, tooltip { font-family: "$FONT", sans-serif !important; }
EOF
  [[ $FIREFOX_CORNERS == round ]] || square_css
}

# Square corners: menus, panels, buttons, tabs, address bar. The variables reach inside
# Firefox's shadow-DOM widgets too, where the * rule cannot.
square_css() {
  cat <<'EOF'

/* Square corners (FIREFOX_CORNERS=round in ~/.config/tuxcraft/state keeps Firefox's) */
:root, menupopup, panel, tooltip {
  --border-radius-small: 0 !important; --border-radius-medium: 0 !important;
  --border-radius-large: 0 !important; --border-radius-xlarge: 0 !important;
  --border-radius-circle: 0 !important;
  --toolbarbutton-border-radius: 0 !important; --tab-border-radius: 0 !important;
  --toolbar-field-border-radius: 0 !important; --urlbar-icon-border-radius: 0 !important;
  --arrowpanel-border-radius: 0 !important; --arrowpanel-menuitem-border-radius: 0 !important;
  --panel-border-radius: 0 !important; --menuitem-border-radius: 0 !important;
  --button-border-radius: 0 !important; --focus-outline-radius: 0 !important;
}
*, *::before, *::after { border-radius: 0 !important; }
EOF
}

content_css() {
  cat <<EOF
/* tuxcraft: generated by tux-firefox for the $name theme. */
@-moz-document url("about:home"), url("about:newtab"), url("about:privatebrowsing") {
  :root, body {
    --newtab-background-color: $bg !important;
    --newtab-background-color-secondary: $bg_alt !important;
    --newtab-text-primary-color: $fg !important;
    --newtab-text-secondary-color: $fg_dim !important;
    --newtab-primary-action-background: $accent !important;
    --newtab-element-hover-color: $bg_hl !important;
    --in-content-page-background: $bg !important;
    background-color: $bg !important;
    color: $fg !important;
  }
}
@-moz-document url("about:blank") {
  html, body { background-color: $bg !important; }
}
EOF
  # Firefox's own pages (settings, add-ons, new tab) get the square corners too; websites keep theirs.
  [[ $FIREFOX_CORNERS == round ]] || cat <<'EOF'
@-moz-document url-prefix("about:") {
  :root {
    --border-radius-small: 0 !important; --border-radius-medium: 0 !important;
    --border-radius-large: 0 !important; --border-radius-xlarge: 0 !important;
    --border-radius-circle: 0 !important; --button-border-radius: 0 !important;
    --focus-outline-radius: 0 !important;
  }
  *, *::before, *::after { border-radius: 0 !important; }
}
EOF
}

prefs_block() {
  local dark docfonts=0 radius=false g
  [[ $variant == light ]] && dark=1 || dark=0
  # Websites: text in the UI font, code in the terminal font. By default every site is made to
  # use them (its own web fonts are ignored; icon fonts on Firefox's allow-list still load).
  # FIREFOX_FONTS=site lets sites pick their fonts again (yours stay the fallback).
  [[ $FIREFOX_FONTS == site ]] && docfonts=1
  [[ $FIREFOX_CORNERS == round ]] && radius=true
  echo "// tuxcraft begin: written by tux-firefox, rewritten on every theme or font change"
  cat <<EOF
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.theme.toolbar-theme", $dark);
user_pref("browser.theme.content-theme", $dark);
user_pref("layout.css.prefers-color-scheme.content-override", $dark);
user_pref("widget.gtk.rounded-bottom-corners.enabled", $radius);
user_pref("browser.display.use_document_fonts", $docfonts);
user_pref("font.default.x-western", "sans-serif");
EOF
  # Latin, Cyrillic, Greek and "other" scripts; the rest (Bengali, CJK…) fall back per glyph.
  for g in x-western x-unicode x-cyrillic x-greek x-central-euro; do
    printf 'user_pref("font.name.sans-serif.%s", "%s");\n' "$g" "$FONT"
    printf 'user_pref("font.name.serif.%s", "%s");\n' "$g" "$FONT"
    printf 'user_pref("font.name.monospace.%s", "%s");\n' "$g" "$TERM_FONT"
  done
  echo "// tuxcraft end"
}

strip_block() { [[ -f $1 ]] && sed '/^\/\/ tuxcraft begin/,/^\/\/ tuxcraft end/d' "$1"; }

# set_import FILE CSSNAME on|off: keep (or drop) our @import as the first line of FILE.
set_import() {
  local f=$1 line="@import \"$2\"; /* tuxcraft */" rest
  rest=$(if [[ -f $f ]]; then grep -vF "$line" "$f"; fi)
  if [[ $3 == on ]]; then printf '%s\n%s' "$line" "${rest:+$rest$'\n'}" >"$f.tux-tmp"
  else [[ -f $f ]] || return 0; printf '%s' "${rest:+$rest$'\n'}" >"$f.tux-tmp"; fi
  mv "$f.tux-tmp" "$f"
  [[ -s $f ]] || rm -f "$f"
}

apply_profile() {
  local p=$1 js=$1/user.js rest
  mkdir -p "$p/chrome"
  if [[ $FIREFOX_THEME == no ]]; then
    set_import "$p/chrome/userChrome.css" tuxcraft.css off
    set_import "$p/chrome/userContent.css" tuxcraft-content.css off
    rm -f "$p/chrome/tuxcraft.css" "$p/chrome/tuxcraft-content.css"
    rest=$(strip_block "$js"); if [[ -n $rest ]]; then printf '%s\n' "$rest" >"$js"; else rm -f "$js"; fi
    return 0
  fi
  chrome_css >"$p/chrome/tuxcraft.css"
  content_css >"$p/chrome/tuxcraft-content.css"
  set_import "$p/chrome/userChrome.css" tuxcraft.css on
  set_import "$p/chrome/userContent.css" tuxcraft-content.css on
  { rest=$(strip_block "$js"); [[ -n $rest ]] && printf '%s\n' "$rest"; prefs_block; } >"$js.tux-tmp" && mv "$js.tux-tmp" "$js"
}

apply() {
  local tf p n=0
  tf=$(theme_file "$THEME") || { echo "tux-firefox: unknown theme $THEME" >&2; return 1; }
  # shellcheck source=/dev/null
  . "$tf"
  variant=${variant:-dark}
  while IFS= read -r p; do apply_profile "$p" && n=$((n + 1)); done < <(profiles)
  echo "tux-firefox: $n profile(s) updated"
}

case ${1:-apply} in
  apply)    apply ;;
  profiles) profiles ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
