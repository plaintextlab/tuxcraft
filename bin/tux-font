#!/usr/bin/env bash
# tux-font — pick the UI font with real previews.
#   tux-font                   menu + preview image
#   tux-font set <key> [size]  e.g. tux-font set dos 13
#   tux-font size <n>          change size only
#   tux-font list
# Fonts not yet installed are downloaded to ~/.local/share/fonts (no root needed).
set -euo pipefail
SHARE=${TUX_SHARE:-/usr/share/tuxcraft}
TABLE="$SHARE/data/fonts.tsv"
STATE="$HOME/.config/tuxcraft/state"
UFONTS="$HOME/.local/share/fonts/tuxcraft"

field() { awk -F'\t' -v k="$1" -v c="$2" '$1==k {print $c}' "$TABLE"; }
state_set() { touch "$STATE"; grep -q "^$1=" "$STATE" && sed -i "s|^$1=.*|$1=\"$2\"|" "$STATE" || echo "$1=\"$2\"" >>"$STATE"; }

ensure() {
  local fam src; fam=$(field "$1" 2); src=$(field "$1" 3)
  fc-list : family | grep -xF "$fam" >/dev/null && return 0
  case $src in
    nerd:*)
      notify-send -u low "Downloading ${src#nerd:} Nerd Font…" 2>/dev/null || echo "Downloading ${src#nerd:}…"
      mkdir -p "$UFONTS/${src#nerd:}"
      curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${src#nerd:}.tar.xz" |
        tar -xJ -C "$UFONTS/${src#nerd:}" ;;
    bundled:*) install -Dm644 "$SHARE/assets/fonts/${src#bundled:}" "$UFONTS/bundled/${src#bundled:}" ;;
  esac
  fc-cache -f "$UFONTS" >/dev/null
}

apply() {  # apply key [size]
  local key=$1 fam; fam=$(field "$key" 2)
  [[ -n $fam ]] || { echo "Unknown font '$key'. Try: tux-font list" >&2; exit 1; }
  ensure "$key"
  state_set FONT "$fam"
  if [[ $key == noto ]]; then state_set TERM_FONT "$(field jetbrains 2)"; ensure jetbrains; else state_set TERM_FONT "$fam"; fi
  [[ -n ${2:-} ]] && { state_set FONT_SIZE "$2"; state_set TERM_FONT_SIZE "$(( $2 + 1 ))"; }
  tux-theme apply
}

# Side by side, centred together: the preview image on the left (floating, scaled to the screen
# height) and the menu on its right, so the menu never covers it.
menu() {
  local img=$SHARE/assets/font-previews/all.png viewer='' pid='' msg='' crit=''
  local -a margs=()
  if [[ -n ${SWAYSOCK:-} ]]; then msg=swaymsg; elif [[ -n ${DISPLAY:-} ]] && pgrep -x i3 >/dev/null; then msg=i3-msg; fi
  if [[ -f $img && -n $msg ]]; then
    local x y w h gap=24 menu_w=760 iw ih ix rect
    rect=$($msg -t get_workspaces | jq -r '.[] | select(.focused) | .rect | "\(.x) \(.y) \(.width) \(.height)"')
    read -r x y w h <<<"${rect:-0 0 1920 1080}"
    # 1000x1936 image: as tall as the screen allows, and never wider than what is left of the menu.
    ih=$(( h - 2 * gap )); iw=$(( ih * 1000 / 1936 ))
    (( iw > w - menu_w - 3 * gap )) && { iw=$(( w - menu_w - 3 * gap )); ih=$(( iw * 1936 / 1000 )); }
    ix=$(( x + (w - iw - gap - menu_w) / 2 ))
    if [[ $msg == i3-msg ]] && command -v feh >/dev/null; then
      viewer=feh crit='[class="^tux-fontpreview$"]'
      feh --class tux-fontpreview --title "Font previews" -x --scale-down -g "${iw}x${ih}+${ix}+$(( y + (h - ih) / 2 ))" "$img" >/dev/null 2>&1 &
      pid=$!
    elif command -v imv >/dev/null; then
      viewer=imv crit='[app_id="^imv$"]'; [[ $msg == i3-msg ]] && crit='[class="^imv$"]'
      imv -s shrink "$img" >/dev/null 2>&1 & pid=$!
    fi
    if [[ -n $viewer ]]; then
      local n=0
      until $msg -t get_tree | grep -e '"tux-fontpreview"' -e '"imv"' -e "\"pid\":$pid," >/dev/null; do
        sleep 0.1; (( ++n > 30 )) && break
      done
      $msg -q "$crit floating enable, border none, resize set $iw $ih, move position $ix $(( y + (h - ih) / 2 ))" >/dev/null 2>&1
      # The menu: same size and height, just right of the image.
      local mx=$(( ix + iw + gap ))
      if [[ $msg == i3-msg ]]; then
        margs=(-location 1 -xoffset "$mx" -yoffset "$(( y + (h - ih) / 2 ))"
               -theme-str "window { width: ${menu_w}px; height: ${ih}px; } listview { lines: 12; }")
      else
        margs=(--anchor top-left --x-margin "$mx" --y-margin "$(( y + (h - ih) / 2 ))" --width 60 --lines 12)
      fi
    fi
  fi
  local pick
  pick=$(awk -F'\t' '!/^#/ && NF>=4 {printf "%-10s %-26s %s\n", $1, $2, $4}' "$TABLE" | tux-menu font -- "${margs[@]}") || true
  [[ -n $pid ]] && kill "$pid" 2>/dev/null
  [[ -n ${pick:-} ]] && apply "${pick%% *}"
}

case ${1:-} in
  set) apply "${2:?font key}" "${3:-}" ;;
  size) state_set FONT_SIZE "${2:?size}"; state_set TERM_FONT_SIZE "$(( $2 + 1 ))"; tux-theme apply ;;
  list) awk -F'\t' '!/^#/ && NF>=4 {printf "%-10s %-26s %s\n", $1, $2, $4}' "$TABLE" ;;
  ""|--menu) menu ;;
  -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) apply "$1" "${2:-}" ;;
esac
