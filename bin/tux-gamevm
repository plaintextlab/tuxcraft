#!/usr/bin/env bash
# tux-gamevm — a Windows gaming VM with GPU passthrough (libvirt/QEMU/KVM), in two modes:
#   single  one GPU (desktop PC): starting the VM closes the Linux desktop and hands the GPU,
#           keyboard, mouse and USB audio to Windows; shutting Windows down gives them back.
#   hybrid  a second GPU drives the screen (laptop: iGPU + NVIDIA/AMD dGPU): Linux keeps running
#           on the iGPU, only the dGPU goes to Windows and comes back when it shuts down.
#           Windows shows on the dGPU's own ports (HDMI) and in a Looking Glass window.
#   The mode is picked automatically (the GPU passed is not the one the system booted on).
#
#   tux-gamevm setup                       host, once: packages, IOMMU, libvirt, hook, groups
#   tux-gamevm create --disk DEV [options] define the VM around a whole disk (Windows lives on it)
#   tux-gamevm create --image FILE --size GiB [options]   ... or around a disk image file
#       --iso FILE        Windows installer ISO (first install only)
#       --unattend FILE   autounattend.xml for an unattended install (attached as a second CD)
#       --virtio-win FILE virtio-win ISO (guest agent, drivers), attached as a CD
#       --win-user NAME --win-password PW [--win-key KEY]   write the unattend file yourself:
#                         local admin that logs in automatically, no setup questions
#       --name NAME       VM name (default win-gaming)
#       --ram GiB         memory (default: all but 15% of the host, which keeps at least 4)
#       --cores N         CPU cores for Windows (default: all but 2), pinned to the last N cores
#       --usb ID,...      USB devices vendor:product to pass (default: keyboards, mice, USB audio)
#       --rom FILE        GPU VBIOS for the passthrough VM (boot screens; needed when the host
#                         boots on that GPU: its ROM is then only a legacy shadow without UEFI)
#       --pass-disk PATH  also give Windows this internal disk while it runs (repeatable; use a
#                         /dev/disk/by-id path). USB storage plugged in at start is passed
#                         automatically; --no-usb-storage turns that off
#       --no-onboard-audio  do not give Windows the motherboard sound (by default it gets an
#                         emulated sound card that plays on it)
#       --wipe            erase DEV first (asks you to type its name; --yes skips that)
#   tux-gamevm install                     the same Windows in a desktop window (setup, repairs; no GPU)
#   tux-gamevm start | stop | kill | status | eject-iso
#   tux-gamevm view                        hybrid: open the Looking Glass window again
#   tux-gamevm guest-setup                 inside the running Windows: Looking Glass host + virtual
#                                          display (hybrid), through the guest agent
#   tux-gamevm hook ...                    called by libvirt (/etc/libvirt/hooks/qemu)
#
# The disk (or image) is used raw, so the Windows install survives a host reinstall:
# run setup + create again (without --wipe) and the same Windows boots.
set -euo pipefail

CONF=/etc/tuxcraft/gamevm.conf
LOG=/var/log/tux-gamevm.log
HOOK=/etc/libvirt/hooks/qemu
VIRSH=(virsh -c qemu:///system)

say()  { printf ':: %s\n' "$*"; }
die()  { printf 'tux-gamevm: %s\n' "$*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"; }
init_system() { if [[ -d /run/systemd/system ]]; then echo systemd; else echo runit; fi; }
distro() {
  if command -v xbps-install >/dev/null; then echo void
  elif command -v pacman >/dev/null; then echo arch
  else echo debian; fi
}
load_conf() {
  [[ -f $CONF ]] || die "no VM yet: run 'tux-gamevm create' first"
  # shellcheck source=/dev/null
  . "$CONF"
}

# ---------------------------------------------------------------------------------- setup
cmd_setup() {
  need_root setup "$@"
  local d; d=$(distro)
  say "Installing virtualisation packages ($d)"
  case $d in
    void)   xbps-install -Sy qemu-system-amd64 libvirt edk2-ovmf dnsmasq nftables psmisc dmidecode virt-viewer ;;
    arch)   pacman -S --needed --noconfirm qemu-desktop libvirt edk2-ovmf dnsmasq nftables psmisc dmidecode virt-viewer ;;
    debian) apt-get install -y qemu-system-x86 libvirt-daemon-system ovmf dnsmasq-base nftables psmisc dmidecode virt-viewer ;;
  esac

  say "Enabling the IOMMU on the kernel command line"
  local params='iommu=pt' g=/etc/default/grub
  grep -q -m1 GenuineIntel /proc/cpuinfo && params='intel_iommu=on iommu=pt'
  if [[ -f $g ]]; then
    local cur p; cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/p' "$g")
    for p in $params; do [[ " $cur " == *" $p "* ]] || cur+=" $p"; done
    sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"${cur# }\"|" "$g"
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || die "grub-mkconfig failed"
  else
    say "No /etc/default/grub: add '$params' to your kernel command line yourself"
  fi

  say "Enabling libvirt"
  if [[ $(init_system) == systemd ]]; then
    systemctl enable --now libvirtd.service virtlogd.service >/dev/null 2>&1 || true
  else
    local s; for s in virtlogd virtlockd libvirtd; do
      [[ -d /etc/sv/$s ]] && ln -sfn "/etc/sv/$s" "/var/service/$s"
    done
    for s in $(seq 20); do "${VIRSH[@]}" version >/dev/null 2>&1 && break; sleep 0.5; done
  fi
  "${VIRSH[@]}" net-info default >/dev/null 2>&1 && {
    "${VIRSH[@]}" net-autostart default >/dev/null 2>&1 || true
    "${VIRSH[@]}" net-start default >/dev/null 2>&1 || true
  }

  say "Installing the libvirt hook (GPU handover)"
  mkdir -p "$(dirname "$HOOK")"
  printf '#!/bin/sh\n# tux-gamevm: hand the GPU between Linux and the gaming VM.\nexec /usr/local/bin/tux-gamevm hook "$@"\n' >"$HOOK"
  chmod 755 "$HOOK"

  local u=${SUDO_USER:-}
  [[ -n $u ]] && { usermod -aG libvirt "$u"; getent group kvm >/dev/null && usermod -aG kvm "$u"; say "Added $u to libvirt/kvm (log in again)"; }
  # QEMU's own user plays the VM's sound on the onboard card (ALSA): it needs the audio group.
  local q; for q in libvirt-qemu qemu libvirt; do
    id "$q" >/dev/null 2>&1 && { usermod -aG audio "$q"; say "QEMU user $q may use the sound card"; break; }
  done

  local f; f=$(gpu_functions | head -n1)
  [[ $(gpu_mode "$f") == hybrid ]] && setup_hybrid "$u" "$f"

  if [[ -z $(ls /sys/kernel/iommu_groups 2>/dev/null) ]]; then
    say "IOMMU is not active yet: reboot. If it is still off afterwards, enable VT-d (Intel) / IOMMU (AMD) in the firmware."
  else
    say "IOMMU active. Next: tux-gamevm create --disk /dev/sdX (or --image FILE --size GiB) --iso windows.iso"
  fi
}

# Hybrid host (laptop): the iGPU keeps the desktop, the dGPU must be free to leave at any time.
setup_hybrid() {  # setup_hybrid USER DGPU
  local u=$1 dgpu=$2 boot b
  say "Hybrid GPUs: $(lspci -s "$dgpu" | cut -d: -f3-) goes to Windows, the boot GPU keeps Linux"
  case $(distro) in
    arch)   pacman -S --needed --noconfirm acpica libisoburn >/dev/null ;;
    void)   xbps-install -Sy acpica-utils libisoburn >/dev/null ;;
    debian) apt-get install -y acpica-tools xorriso >/dev/null ;;
  esac

  # X must not open the dGPU (it would hold it, and the handover would need a logout):
  # use only the boot GPU and do not add others as PRIME GPU screens.
  for b in /sys/bus/pci/devices/*/boot_vga; do [[ $(<"$b") == 1 ]] && boot=$(basename "$(dirname "$b")"); done
  if [[ -n $boot ]]; then
    mkdir -p /etc/X11/xorg.conf.d
    cat >/etc/X11/xorg.conf.d/10-tux-gamevm-hybrid.conf <<EOF
# tux-gamevm (hybrid): X runs on the boot GPU only, so the dGPU can go to the gaming VM and come
# back without logging out. Remove this file to give X the dGPU again (PRIME offload).
Section "ServerFlags"
    Option "AutoAddGPU" "off"
EndSection

Section "Device"
    Identifier "boot-gpu"
    Driver     "modesetting"
    BusID      "PCI:$((16#${boot:5:2})):$((16#${boot:8:2})):${boot:11:1}"
EndSection
EOF
    say "X now uses only the boot GPU ($boot): log out and in once"
  fi

  # The dGPU's HDMI audio: Linux does not drive the dGPU's ports, and PipeWire keeping the card
  # open makes the kernel wait forever when libvirt unbinds it (the VM never starts).
  local a rules=''
  for a in $(lspci -D -s "${dgpu%.*}" | awk '/Audio/ {print $1}'); do
    rules+="  { matches = [ { device.name = \"alsa_card.pci-$(tr ':' '_' <<<"$a")\" } ]
    actions = { update-props = { device.disabled = true } } }
"
  done
  if [[ -n $rules ]]; then
    mkdir -p /etc/wireplumber/wireplumber.conf.d
    printf '# tux-gamevm (hybrid): the dGPU HDMI audio belongs to the gaming VM.\nmonitor.alsa.rules = [\n%s]\n' "$rules" \
      >/etc/wireplumber/wireplumber.conf.d/50-tux-gamevm-dgpu-audio.conf
    say "PipeWire leaves the dGPU's HDMI audio alone (applies after the next login)"
  fi

  # QEMU runs as the desktop user: Looking Glass shares memory with it, and its sound reaches
  # the user's PipeWire through the Looking Glass (SPICE) window.
  if [[ -n $u ]]; then
    local q=/etc/libvirt/qemu.conf
    sed -i '/^# tux-gamevm user begin/,/^# tux-gamevm user end/d' "$q"
    printf '# tux-gamevm user begin\nuser = "%s"\ngroup = "kvm"\n# tux-gamevm user end\n' "$u" >>"$q"
    if [[ $(init_system) == systemd ]]; then systemctl restart libvirtd; else sv restart libvirtd >/dev/null; fi
  fi

  # NVIDIA laptop GPUs refuse to start in a VM without a battery (error 43): give it one.
  if compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
    local d=/var/lib/libvirt/acpi t; mkdir -p "$d"; t=$(mktemp -d)
    cat >"$t/fake-battery.asl" <<'EOF'
DefinitionBlock ("", "SSDT", 1, "TUXCFT", "FAKEBAT", 0x00000001)
{
    External (\_SB.PCI0, DeviceObj)
    Scope (\_SB.PCI0)
    {
        Device (BAT0)
        {
            Name (_HID, EisaId ("PNP0C0A"))
            Name (_UID, One)
            Method (_STA, 0, NotSerialized) { Return (0x1F) }
            Method (_BIF, 0, NotSerialized)
            {
                Return (Package (0x0D) { One, 0x1770, 0x1770, One, 0x39D0, 0x0258, 0x012C,
                                         0x3C, 0x3C, "VM", "1", "LION", "tuxcraft" })
            }
            Method (_BST, 0, NotSerialized) { Return (Package (0x04) { Zero, Zero, 0x1770, 0x39D0 }) }
        }
    }
}
EOF
    if (cd "$t" && iasl -p fake-battery fake-battery.asl >/dev/null 2>&1); then
      install -m644 "$t/fake-battery.aml" "$d/fake-battery.aml"; say "Fake battery ACPI table: $d/fake-battery.aml"
    else say "iasl failed: no fake battery table (NVIDIA may show error 43 in Windows)"; fi
    rm -rf "$t"
  fi

  [[ -n $u ]] && setup_looking_glass "$u"
}

# Looking Glass: shows the VM's screen in a window, with keyboard, mouse, sound and clipboard.
# The Windows side (host app) must be the same version; it is fetched into the VM later.
LG_VERSION=B7
setup_looking_glass() {  # setup_looking_glass USER
  local u=$1 home; home=$(getent passwd "$u" | cut -d: -f6)
  if ! command -v looking-glass-client >/dev/null; then
    if [[ $(distro) == arch ]]; then
      say "Building the Looking Glass client ($LG_VERSION) from the AUR"
      local t; t=$(mktemp -d); chown "$u:" "$t"
      runuser -u "$u" -- git clone -q https://aur.archlinux.org/looking-glass.git "$t/lg" || die "AUR clone failed"
      # makepkg may not install dependencies itself without a sudo prompt: do it here.
      # shellcheck disable=SC2046
      pacman -S --needed --noconfirm --asdeps $(sed -n 's/^\t\(make\)\?depends = \([^<>=]*\).*/\2/p' "$t/lg/.SRCINFO" | sort -u) >/dev/null
      (cd "$t/lg" && runuser -u "$u" -- makepkg -f --noconfirm >/dev/null 2>&1) || die "building looking-glass failed (try: cd $t/lg && makepkg -s)"
      pacman -U --noconfirm "$t"/lg/looking-glass-[0-9B]*.pkg.tar.zst >/dev/null || die "installing looking-glass failed"
      rm -rf "$t"
    else
      say "Install the Looking Glass client $LG_VERSION yourself (https://looking-glass.io/downloads)"
    fi
  fi
  # Laptops often have no Scroll Lock (Looking Glass's default escape key): use Right Ctrl.
  mkdir -p "$home/.config/looking-glass"
  [[ -f $home/.config/looking-glass/client.ini ]] || cat >"$home/.config/looking-glass/client.ini" <<'EOF'
; tux-gamevm: Looking Glass client. Right Ctrl = escape key (Right Ctrl+Q quits, Right Ctrl+F fullscreen)
[app]
shmFile=/dev/shm/looking-glass

[win]
title=Windows (gaming VM)
size=1600x900
autoResize=yes
quickSplash=yes

[input]
escapeKey=KEY_RIGHTCTRL
rawMouse=yes

[spice]
enable=yes
audio=yes
EOF
  chown -R "$u:" "$home/.config/looking-glass"
}

# --------------------------------------------------------------------------------- create
gpu_functions() {  # all PCI functions of the GPU to pass, e.g. 0000:01:00.0 0000:01:00.1
  local vga='' slot d
  # A GPU the system did not boot on (laptop dGPU next to the iGPU) first, else the first one.
  for d in $(lspci -Dnn | awk '/(VGA compatible|3D) controller/ && /NVIDIA|AMD|ATI/ {print $1}'); do
    [[ $(cat "/sys/bus/pci/devices/$d/boot_vga" 2>/dev/null) == 0 ]] && { vga=$d; break; }
  done
  [[ -n $vga ]] || vga=$(lspci -Dnn | awk '/(VGA compatible|3D) controller/ && /NVIDIA|AMD|ATI/ {print $1; exit}')
  [[ -n $vga ]] || die "no NVIDIA/AMD GPU found"
  slot=${vga%.*}
  lspci -D | awk -v s="$slot" 'index($1, s".")==1 {print $1}'
}
# hybrid: this GPU is not the one the system booted on, and another GPU drives the screen.
gpu_mode() {
  local b
  [[ $(cat "/sys/bus/pci/devices/$1/boot_vga" 2>/dev/null) == 0 ]] || { echo single; return; }
  for b in /sys/bus/pci/devices/*/boot_vga; do [[ $(<"$b") == 1 ]] && { echo hybrid; return; }; done
  echo single
}
default_usb() {  # keyboards, mice, USB audio and Bluetooth adapters, as vendor:product
  local d i ids=()
  for d in /sys/bus/usb/devices/*; do
    [[ -f $d/idVendor ]] || continue
    for i in "$d"/*:*/; do
      [[ -f $i/bInterfaceClass ]] || continue
      # class 01 = audio; 03 (HID) protocol 01/02 = keyboard/mouse; e0/01/01 = Bluetooth adapter
      if [[ $(<"$i/bInterfaceClass") == 01 ]] ||
         [[ $(<"$i/bInterfaceClass") == 03 && $(<"$i/bInterfaceProtocol") =~ ^0[12]$ ]] ||
         [[ $(<"$i/bInterfaceClass") == e0 && $(<"$i/bInterfaceSubClass") == 01 && $(<"$i/bInterfaceProtocol") == 01 ]]; then
        ids+=("$(<"$d/idVendor"):$(<"$d/idProduct")"); break
      fi
    done
  done
  ((${#ids[@]})) && printf '%s\n' "${ids[@]}" | sort -u | paste -sd,
}
# The motherboard's sound card (not the GPU's HDMI audio, not USB) as an ALSA device name.
# It usually shares an IOMMU group with the chipset (LPC, SMBus, ...), so it cannot be passed
# through; Windows gets an emulated Intel HDA card that plays into it directly instead (the
# host's PipeWire is stopped while Windows runs, so the card is free).
onboard_alsa() {
  local c dev gpuslot; gpuslot=$(gpu_functions | head -n1); gpuslot=${gpuslot%.*}
  for c in /proc/asound/card[0-9]*; do
    dev=$(readlink -f "/sys/class/sound/$(basename "$c")/device" 2>/dev/null) || continue
    [[ $dev == */usb* || $(basename "$dev") == "$gpuslot".* ]] && continue
    [[ -f $c/id ]] && { echo "plughw:CARD=$(<"$c/id"),DEV=0"; return; }
  done
}
# libvirt runs QEMU with a private /dev and a device cgroup holding only what the VM is known to
# use; it does not add the sound card for an ALSA audio backend ("No such device" in the QEMU
# log). Devices in cgroup_device_acl are allowed AND put into that /dev, so list the card there.
sound_acl() {  # sound_acl plughw:CARD=ID,DEV=0
  local id=${1#*CARD=}; id=${id%%,*}
  local card; card=$(readlink "/proc/asound/$id") || { say "sound card $id not found"; return 1; }
  local n=${card#card} nodes=() q=/etc/libvirt/qemu.conf f
  for f in /dev/snd/controlC"$n" /dev/snd/pcmC"$n"D* /dev/snd/timer; do [[ -e $f ]] && nodes+=("\"$f\""); done
  local acl='"/dev/null", "/dev/full", "/dev/zero", "/dev/random", "/dev/urandom", "/dev/ptmx", "/dev/userfaultfd"'
  acl+=$(printf ', %s' "${nodes[@]}")
  local block; block=$(printf '# tux-gamevm begin: the onboard sound card (%s) for the VM sound backend\ncgroup_device_acl = [ %s ]\n# tux-gamevm end' "$id" "$acl")
  local cur; cur=$(sed -n '/^# tux-gamevm begin/,/^# tux-gamevm end/p' "$q")
  [[ $cur == "$block" ]] && return 0
  sed -i '/^# tux-gamevm begin/,/^# tux-gamevm end/d' "$q"
  printf '%s\n' "$block" >>"$q"
  say "Allowed QEMU to use the sound card $id (libvirt qemu.conf)"
  if "${VIRSH[@]}" list --name | grep -q .; then
    say "A VM is running: restart libvirt after it stops for the sound change to apply"
  elif [[ $(init_system) == systemd ]]; then systemctl restart libvirtd
  else sv restart libvirtd >/dev/null; sleep 2
  fi
}
# install_rom SRC DST: copy a VBIOS dump starting at its first PCI ROM image (NVIDIA dumps can
# carry a header before it, which QEMU rejects). Fails unless the ROM contains a UEFI image.
install_rom() {  # install_rom SRC DST [any]  (any: a ROM without UEFI image is fine, e.g. laptop dGPU)
  python3 - "$1" "$2" ${3:+"$3"} <<'PY'
import sys
d = open(sys.argv[1], 'rb').read()
start = off = d.find(b'\x55\xaa'); efi = False
while 0 <= off < len(d) - 0x1a:
    p = off + int.from_bytes(d[off + 0x18:off + 0x1a], 'little')
    if d[p:p + 4] != b'PCIR':
        if off == start:
            start = off = d.find(b'\x55\xaa', off + 2); continue
        break
    size = int.from_bytes(d[p + 0x10:p + 0x12], 'little') * 512
    efi |= d[p + 0x14] == 3
    if d[p + 0x15] & 0x80 or size == 0:
        break
    off += size
if start < 0 or (not efi and sys.argv[3:] != ['any']):
    sys.exit(1)
# Keep the whole image chain from its first image. On an RTX 5070 (Blackwell) dump, starting at
# the VGA BIOS instead (the usual advice for older NVIDIA cards) left Windows with no display:
# the NVIDIA-specific images (code type 0xE0) before it are needed.
open(sys.argv[2], 'wb').write(d[start:])
print(f":: VBIOS installed as {sys.argv[2]} ({len(d) - start} bytes, UEFI image {'present' if efi else 'absent'}"
      + (f", {start}-byte header removed)" if start else ")"))
PY
  local rc=$?; [[ -f $2 ]] && chmod 644 "$2"; return $rc
}
ovmf_code() {
  local f; for f in /usr/share/edk2/x64/OVMF_CODE.4m.fd /usr/share/edk2/x64/OVMF_CODE.fd \
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd; do
    [[ -f $f ]] && { echo "$f"; return 0; }; done
  die "OVMF firmware not found (run tux-gamevm setup)"
}

cmd_create() {
  need_root create "$@"
  local name=win-gaming disk='' iso='' ram='' cores='' usb='' romfile='' wipe=0 yes=0
  local passdisks='' passusb='' onboard='' image='' size='' unattend='' virtio='' winuser='' winpass='' winkey=''
  while (($#)); do
    case $1 in
      --name) name=$2; shift ;; --disk) disk=$2; shift ;; --iso) iso=$2; shift ;;
      --image) image=$2; shift ;; --size) size=$2; shift ;;
      --unattend) unattend=$2; shift ;; --virtio-win) virtio=$2; shift ;;
      --win-user) winuser=$2; shift ;; --win-password) winpass=$2; shift ;; --win-key) winkey=$2; shift ;;
      --ram) ram=$2; shift ;; --cores) cores=$2; shift ;; --usb) usb=$2; shift ;;
      --rom) romfile=$2; shift ;;
      --pass-disk) [[ -b $2 ]] || die "--pass-disk: $2 is not a block device"; passdisks+="${passdisks:+ }$2"; shift ;;
      --no-usb-storage) passusb=no ;;
      --no-onboard-audio) onboard=no ;;
      --wipe) wipe=1 ;; --yes) yes=1 ;; *) die "unknown option $1" ;;
    esac; shift
  done
  [[ -n $disk || -n $image ]] || die "--disk DEV (a whole disk for Windows) or --image FILE --size GiB is required"
  [[ -n $disk && -n $image ]] && die "give --disk or --image, not both"
  [[ -z $iso || -f $iso ]] || die "ISO not found: $iso"
  [[ -z $virtio || -f $virtio ]] || die "virtio-win ISO not found: $virtio"
  [[ -z $unattend || -f $unattend ]] || die "unattend file not found: $unattend"
  local dev='' disktype=block
  if [[ -n $image ]]; then
    disktype='file'
    image=$(realpath -m "$image")
    if [[ ! -f $image ]]; then
      [[ $size =~ ^[0-9]+$ ]] || die "--size GiB is required for a new image"
      mkdir -p "$(dirname "$image")"
      touch "$image"
      # btrfs: copy-on-write fragments a VM image badly and snapshots would keep every change.
      [[ $(stat -f -c %T "$(dirname "$image")") == btrfs ]] && chattr +C "$image" 2>/dev/null
      truncate -s "${size}G" "$image"   # sparse: takes space only as Windows writes
      say "Created $image (${size} GiB, sparse)"
    fi
    disk=$image
  else
    [[ -b $disk ]] || die "$disk is not a block device"
    dev=$(readlink -f "$disk")
    [[ $(lsblk -dno TYPE "$dev") == disk ]] || die "$disk is a partition; give the whole disk"
    local rootdisk; rootdisk=$(lsblk -no PKNAME "$(findmnt -no SOURCE / | sed 's/\[.*\]//')")
    [[ $(basename "$dev") != "$rootdisk" ]] || die "$disk holds the running Linux system"
  fi

  local total_gib host_cores; total_gib=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1048576 ))
  host_cores=$(nproc)
  # Keep earlier RAM/core choices unless given again.
  if [[ -f $CONF ]]; then
    [[ -n $ram ]] || ram=$(sed -n 's/^RAM=//p' "$CONF")
    [[ -n $cores ]] || cores=$(sed -n 's/^CORES=//p' "$CONF")
  fi
  # While Windows runs the host has no desktop: services + kernel + QEMU overhead are ~2-3 GiB.
  # Passthrough pins all guest RAM (no swapping it back), so keep a real margin: 15%, >= 4 GiB.
  local reserve=$(( (total_gib * 15 + 99) / 100 )); (( reserve < 4 )) && reserve=4
  ram=${ram:-$(( total_gib - reserve > 4 ? total_gib - reserve : 4 ))}
  (( ram >= 2 && ram <= total_gib - 2 )) || die "--ram must be 2..$((total_gib - 2)) GiB (the host keeps at least 2)"
  cores=${cores:-$(( host_cores > 4 ? host_cores - 2 : host_cores - 1 ))}
  (( cores >= 1 && cores < host_cores )) || die "--cores must be 1..$((host_cores - 1)) (the host keeps at least one)"
  mapfile -t gpu < <(gpu_functions)
  local mode; mode=$(gpu_mode "${gpu[0]}")
  # Hybrid: Linux keeps its keyboard and mouse; Windows gets input through Looking Glass.
  if [[ $mode == hybrid ]]; then usb=${usb:-none}; else usb=${usb:-$(default_usb)}; fi
  [[ $usb == none ]] && usb=''

  local ptuuid=''
  if [[ $disktype == block ]]; then
  unmount_disk "$dev"
  if ((wipe)); then
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MODEL "$dev"
    if ((!yes)); then
      local a; read -r -p "ERASE everything on $(basename "$dev")? Type its name to confirm: " a
      [[ $a == "$(basename "$dev")" ]] || die "aborted, nothing changed"
    fi
    wipefs -a "$dev" >/dev/null; sgdisk --zap-all "$dev" >/dev/null 2>&1 || true
    say "Erased $disk"
  fi

  # Identify the disk by its GPT GUID, never by serial: USB enclosures (e.g. RTL9210) report the
  # same fake serial for every unit, so a serial/by-id path can point at a different disk.
  # A blank disk gets an empty GPT first; Windows Setup installs into it and keeps the GUID.
  ptuuid=$(lsblk -dno PTUUID "$dev")
  if [[ -z $ptuuid ]]; then
    lsblk -no FSTYPE "$dev" | grep -q . && die "$disk has data but no partition table; use --wipe if it may be erased"
    printf 'label: gpt\n' | sfdisk -q "$dev" >/dev/null && udevadm settle
    ptuuid=$(lsblk -dno PTUUID "$dev")
  fi
  [[ $ptuuid =~ ^[0-9a-fA-F-]{36}$ ]] || die "could not read a GPT GUID from $disk"
  local link=/dev/tux-gamevm-$name
  mkdir -p /etc/udev/rules.d
  cat >"/etc/udev/rules.d/61-tux-gamevm-$name.rules" <<EOF
# tux-gamevm: the disk with GPT GUID $ptuuid belongs to the '$name' VM.
# udisks/udiskie must never mount it (both systems using it at once corrupts it), and the VM
# reaches it through $link, which exists only for this exact disk.
ENV{ID_PART_TABLE_UUID}=="$ptuuid", ENV{UDISKS_IGNORE}="1"
ENV{DEVTYPE}=="disk", ENV{ID_PART_TABLE_UUID}=="$ptuuid", SYMLINK+="tux-gamevm-$name"
EOF
  rm -f /etc/udev/rules.d/61-tux-gamevm-disk.rules   # old serial-based rule
  udevadm control --reload; udevadm trigger --action=change --sysname-match="$(basename "$dev")*"; udevadm settle
  [[ $(readlink -f "$link") == "$dev" ]] || die "udev did not create $link for $disk"
  disk=$link
  fi

  local code vars; code=$(ovmf_code); vars=${code/CODE/VARS}
  [[ -f $vars ]] || die "OVMF VARS template not found next to $code"

  # Pin Windows to the last N CPUs; QEMU's own threads to the rest.
  local first=$(( host_cores - cores )) pins='' i threads=1
  for ((i = 0; i < cores; i++)); do pins+="    <vcpupin vcpu='$i' cpuset='$((first + i))'/>"$'\n'; done
  # When those CPUs are whole SMT pairs (cpuN + cpuN+1), tell Windows: it schedules better.
  if (( cores % 2 == 0 && first % 2 == 0 )); then
    threads=2
    for ((i = first; i < host_cores; i += 2)); do
      [[ $(cat "/sys/devices/system/cpu/cpu$i/topology/thread_siblings_list" 2>/dev/null) =~ ^${i}[-,]$((i + 1))$ ]] || { threads=1; break; }
    done
  fi
  # GPU VBIOS: --rom, else the one an earlier create recorded.
  local romdst=''
  if [[ -n $romfile ]]; then
    [[ -f $romfile ]] || die "ROM not found: $romfile"
    romdst=/var/lib/libvirt/vbios/$(basename "${romfile%.*}").rom
    mkdir -p /var/lib/libvirt/vbios
    install_rom "$romfile" "$romdst" || die "$romfile has no UEFI (GOP) image: it would not show the boot screens"
  elif [[ -f $CONF ]]; then
    romdst=$(sed -n 's/^ROM=//p' "$CONF"); [[ -f $romdst ]] || romdst=''
  fi
  # Hybrid: no ROM file unless asked for. On an OMEN 16 (RTX 3070 Ti Laptop) the dumped VBIOS's
  # UEFI driver hung the VM firmware at 100% of one core; without it Windows booted in 20 s.
  # A copy is still saved next to the others, for --rom if a driver ever needs it.
  if [[ -z $romdst && $mode == hybrid && ! -f /var/lib/libvirt/vbios/dgpu-saved.rom ]]; then
    local r=/sys/bus/pci/devices/${gpu[0]}/rom
    mkdir -p /var/lib/libvirt/vbios
    if echo 1 >"$r" 2>/dev/null && cat "$r" >/var/lib/libvirt/vbios/dgpu-saved.rom 2>/dev/null; then
      say "dGPU VBIOS saved as /var/lib/libvirt/vbios/dgpu-saved.rom (not used; --rom FILE to try it)"
    fi
    echo 0 >"$r" 2>/dev/null || true
  fi
  # shellcheck disable=SC2016  # the single quotes are XML attribute quotes; $romdst does expand
  local hostdevs='' f rom=" <rom bar='on'${romdst:+ file='$romdst'}/>"
  # Hybrid without a ROM file: hide the dGPU's ROM from the VM firmware. Its UEFI driver hangs
  # OVMF on every warm reboot (the GPU is already initialised by Windows); the Windows driver
  # works without it (tested: RTX 3070 Ti Laptop, driver OK, reboots fine).
  [[ $mode == hybrid && -z $romdst ]] && rom=" <rom bar='off'/>"
  for f in "${gpu[@]}"; do
    hostdevs+="    <hostdev mode='subsystem' type='pci' managed='yes'><source><address domain='0x${f:0:4}' bus='0x${f:5:2}' slot='0x${f:8:2}' function='0x${f:11:1}'/></source>${rom}</hostdev>"$'\n'
    rom=''
  done
  local id
  for id in ${usb//,/ }; do
    hostdevs+="    <hostdev mode='subsystem' type='usb' managed='yes'><source startupPolicy='optional'><vendor id='0x${id%%:*}'/><product id='0x${id##*:}'/></source></hostdev>"$'\n'
  done
  # QEMU runs as an unprivileged user that may not enter /home: keep copies next to the image
  # (an image dir is outside the snapshots), else in libvirt's image dir.
  local cdrom='' isodir=/var/lib/libvirt/images
  [[ $disktype == file ]] && isodir=$(dirname "$disk")
  mkdir -p "$isodir"
  cd_xml() {  # cd_xml SRC TARGET [boot]: copy SRC into isodir, print the CD element
    local dst; dst=$isodir/$(basename "$1")
    [[ $1 -ef $dst ]] || [[ -f $dst && $(stat -c %s "$dst") == $(stat -c %s "$1") ]] || { say "Copying $(basename "$1") to $isodir" >&2; install -m644 "$1" "$dst"; }
    printf "    <disk type='file' device='cdrom'><driver name='qemu' type='raw'/><source file='%s'/><target dev='%s' bus='sata'/><readonly/>%s</disk>\n" \
      "$dst" "$2" "${3:+<boot order='1'/>}"
  }
  [[ -n $iso ]] && cdrom+=$(cd_xml "$iso" sdb boot)$'\n'
  # Unattended install: Windows Setup reads autounattend.xml from the root of any CD.
  if [[ -n $winuser ]]; then
    unattend=$(mktemp); write_unattend "$winuser" "$winpass" "$winkey" >"$unattend"
  fi
  if [[ -n $unattend ]]; then
    local ud; ud=$(mktemp -d); cp "$unattend" "$ud/autounattend.xml"
    xorriso -as mkisofs -quiet -J -r -V UNATTEND -o "$isodir/$name-unattend.iso" "$ud" 2>/dev/null || die "could not build the unattend ISO (xorriso missing?)"
    rm -rf "$ud"; [[ -n $winuser ]] && rm -f "$unattend"
    chmod 600 "$isodir/$name-unattend.iso"   # holds the Windows password
    cdrom+=$(cd_xml "$isodir/$name-unattend.iso" sdc)$'\n'
  fi
  [[ -n $virtio ]] && cdrom+=$(cd_xml "$virtio" sdd)$'\n'

  # Two VMs on the same disk: "$name" (GPU passthrough, the hook hands the GPU over) and
  # "$name-install" (a window on the Linux desktop, no passthrough) for setup and repairs.
  local sound='' acpitable=''
  if [[ $mode == hybrid ]]; then
    # Linux keeps running: no onboard sound card to take over. Sound, keyboard and mouse go
    # through the SPICE channel that the Looking Glass window uses; the picture through shared memory.
    onboard=no
    [[ -f /var/lib/libvirt/acpi/fake-battery.aml ]] && acpitable=/var/lib/libvirt/acpi/fake-battery.aml
    sound=$(printf '    %s\n' \
      "<graphics type='spice' autoport='yes'><listen type='address' address='127.0.0.1'/><image compression='off'/></graphics>" \
      "<channel type='spicevmc'><target type='virtio' name='com.redhat.spice.0'/></channel>" \
      "<input type='mouse' bus='ps2'/><input type='keyboard' bus='ps2'/>" \
      "<sound model='ich9'><audio id='1'/></sound>" \
      "<audio id='1' type='spice'/>" \
      "<shmem name='looking-glass'><model type='ivshmem-plain'/><size unit='M'>128</size></shmem>")$'\n'
  else
    # Onboard sound: keep the earlier choice unless given again.
    [[ -z $onboard && -f $CONF ]] && onboard=$(sed -n 's/^ONBOARD_AUDIO=//p' "$CONF")
    [[ $onboard == no ]] || onboard=$(onboard_alsa)
    [[ -n $onboard && $onboard != no ]] && sound_acl "$onboard"
    [[ -n $onboard && $onboard != no ]] && sound=$(printf '    %s\n' \
      "<sound model='ich9'><codec type='duplex'/><audio id='1'/></sound>" \
      "<audio id='1' type='alsa'><input dev='$onboard'/><output dev='$onboard'/></audio>")$'\n'
  fi
  define_domain "$name" "Windows with $mode-GPU passthrough" \
    "    <video><model type='none'/></video>"$'\n'"$sound$hostdevs"
  acpitable=''   # the window VM has no dGPU: no fake battery needed
  local windowed
  windowed=$(printf '    %s\n' \
    "<graphics type='spice' autoport='yes'><listen type='address' address='127.0.0.1'/></graphics>" \
    "<video><model type='qxl' vram='65536' heads='1' primary='yes'/></video>" \
    "<input type='tablet' bus='usb'/>")
  define_domain "$name-install" "install/repair mode: a window on the Linux desktop, no passthrough" "$windowed"$'\n'
  # Shared drives: keep earlier choices unless given again.
  if [[ -f $CONF ]]; then
    [[ -n $passdisks ]] || passdisks=$(sed -n 's/^PASS_DISKS="\(.*\)"$/\1/p' "$CONF")
    [[ -n $passusb ]] || passusb=$(sed -n 's/^PASS_USB_STORAGE=//p' "$CONF")
  fi
  mkdir -p "$(dirname "$CONF")"
  cat >"$CONF" <<EOF
# tux-gamevm — written by 'tux-gamevm create'
NAME=$name
MODE=$mode
DISK=$disk
DISK_TYPE=$disktype
DISK_ID=$ptuuid
GPU="${gpu[*]}"
USB=$usb
RAM=$ram
CORES=$cores
ROM=$romdst
PASS_USB_STORAGE=${passusb:-yes}
PASS_DISKS="$passdisks"
ONBOARD_AUDIO=${onboard:-no}
EOF
  say "Defined '$name': ${cores} cores (host cores ${first}-$((host_cores - 1))), ${ram} GiB, GPU ${gpu[*]}, USB $usb"
  say "Defined '$name-install' (tux-gamevm install): same disk in a desktop window, for setup and repairs"
  say "Disk $disk (SATA), network e1000e: Windows needs no extra drivers."
  [[ -z $(ls /sys/kernel/iommu_groups 2>/dev/null) ]] && say "IOMMU not active yet: reboot before 'tux-gamevm start'."
  return 0
}

# define_domain NAME DESCRIPTION DEVICES — uses create's variables (dynamic scope).
define_domain() {
  local dname=$1 desc=$2 devs=$3 uuid xml
  local nvram=/var/lib/libvirt/qemu/nvram/${dname}_VARS.fd
  # Re-running create updates the existing VM (same UUID, keeps its NVRAM) instead of clashing.
  uuid=$("${VIRSH[@]}" domuuid "$dname" 2>/dev/null | head -n1 || true)
  xml=$(mktemp)
  local diskxml qemuns='' qemucmd='' cpufeat=''
  # AMD: without topoext Windows does not see the SMT threads (worse scheduling and latency).
  grep -q -m1 AuthenticAMD /proc/cpuinfo && ((threads > 1)) && cpufeat="
    <feature policy='require' name='topoext'/>"
  if [[ $disktype == file ]]; then
    diskxml="<disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source file='$disk'/><target dev='sda' bus='sata'/><boot order='2'/>
    </disk>"
  else
    diskxml="<disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source dev='$disk'/><target dev='sda' bus='sata'/><boot order='2'/>
    </disk>"
  fi
  if [[ -n $acpitable ]]; then
    qemuns=" xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'"
    qemucmd="
  <qemu:commandline><qemu:arg value='-acpitable'/><qemu:arg value='file=$acpitable'/></qemu:commandline>"
  fi
  cat >"$xml" <<XML
<domain type='kvm'$qemuns>
  <name>$dname</name>${uuid:+
  <uuid>$uuid</uuid>}
  <description>tux-gamevm: $desc. Disk: $disk</description>
  <memory unit='GiB'>$ram</memory>
  <vcpu placement='static'>$cores</vcpu>
  <cputune>
$pins    <emulatorpin cpuset='0-$((first - 1))'/>
  </cputune>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash'>$code</loader>
    <nvram template='$vars'>$nvram</nvram>
  </os>
  <features>
    <acpi/><apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/><vapic state='on'/><spinlocks state='on' retries='8191'/>
      <vpindex state='on'/><synic state='on'/><stimer state='on'/><reset state='on'/>
      <frequencies state='on'/><tlbflush state='on'/><ipi state='on'/>
      <vendor_id state='on' value='tuxcraft'/>
    </hyperv>
    <kvm><hidden state='on'/></kvm>
    <vmport state='off'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='$((cores / threads))' threads='$threads'/>
    <cache mode='passthrough'/>$cpufeat
  </cpu>
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/><timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/><timer name='hypervclock' present='yes'/>
  </clock>
  <on_poweroff>destroy</on_poweroff><on_reboot>restart</on_reboot><on_crash>destroy</on_crash>
  <pm><suspend-to-mem enabled='no'/><suspend-to-disk enabled='no'/></pm>
  <devices>
    $diskxml
$cdrom
    <controller type='usb' model='qemu-xhci' ports='15'/>
    <interface type='network'><source network='default'/><model type='e1000e'/></interface>
    <channel type='unix'><target type='virtio' name='org.qemu.guest_agent.0'/></channel>
$devs    <memballoon model='none'/>
  </devices>$qemucmd
</domain>
XML
  "${VIRSH[@]}" define "$xml" >/dev/null || { cp "$xml" /tmp/tux-gamevm-failed.xml; die "virsh define $dname failed (XML kept in /tmp/tux-gamevm-failed.xml)"; }
  rm -f "$xml"
}

# autounattend.xml: Windows 10/11 x64 on the first disk (wiped), local admin account that logs
# in automatically, no OOBE questions. At first logon it turns hibernation off (a hibernated
# Windows corrupts shared drives) and installs the virtio guest tools if their CD is attached.
#   KEY (optional): the edition's installation key. Media without a built-in edition choice
#   (e.g. LTSC) need one; Microsoft's published KMS client keys install but do not activate.
write_unattend() {  # write_unattend USER PASSWORD [KEY]
  local u p tz='UTC'
  u=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"); p=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$2")
  # Windows time zone names differ from tzdata; the common ones, else UTC (fixable in Settings).
  case $(readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##') in
    Asia/Kolkata|Asia/Calcutta) tz='India Standard Time' ;; Europe/London) tz='GMT Standard Time' ;;
    Europe/Berlin|Europe/Paris|Europe/Amsterdam|Europe/Madrid|Europe/Rome) tz='W. Europe Standard Time' ;;
    America/New_York) tz='Eastern Standard Time' ;; America/Chicago) tz='Central Standard Time' ;;
    America/Los_Angeles) tz='Pacific Standard Time' ;;
  esac
  local c='processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"'
  cat <<EOF
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" $c>
      <SetupUILanguage><UILanguage>en-US</UILanguage></SetupUILanguage>
      <InputLocale>en-US</InputLocale><SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage><UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" $c>
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID><WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add"><Order>1</Order><Type>EFI</Type><Size>300</Size></CreatePartition>
            <CreatePartition wcm:action="add"><Order>2</Order><Type>MSR</Type><Size>16</Size></CreatePartition>
            <CreatePartition wcm:action="add"><Order>3</Order><Type>Primary</Type><Extend>true</Extend></CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add"><Order>1</Order><PartitionID>1</PartitionID><Format>FAT32</Format><Label>System</Label></ModifyPartition>
            <ModifyPartition wcm:action="add"><Order>2</Order><PartitionID>3</PartitionID><Format>NTFS</Format><Label>Windows</Label><Letter>C</Letter></ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      <ImageInstall><OSImage>
        <InstallTo><DiskID>0</DiskID><PartitionID>3</PartitionID></InstallTo>
        <InstallFrom><MetaData wcm:action="add"><Key>/IMAGE/INDEX</Key><Value>1</Value></MetaData></InstallFrom>
      </OSImage></ImageInstall>
      <UserData><AcceptEula>true</AcceptEula>${3:+<ProductKey><Key>$3</Key><WillShowUI>OnError</WillShowUI></ProductKey>}</UserData>
    </component>
  </settings>
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" $c>
      <ComputerName>GAMEVM</ComputerName><TimeZone>$tz</TimeZone>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" $c>
      <InputLocale>en-US</InputLocale><SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage><UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" $c>
      <OOBE>
        <HideEULAPage>true</HideEULAPage><HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE><HideLocalAccountScreen>true</HideLocalAccountScreen>
        <NetworkLocation>Home</NetworkLocation><ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts><LocalAccounts>
        <LocalAccount wcm:action="add">
          <Name>$u</Name><Group>Administrators</Group><DisplayName>$u</DisplayName>
          <Password><Value>$p</Value><PlainText>true</PlainText></Password>
        </LocalAccount>
      </LocalAccounts></UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled><Username>$u</Username><LogonCount>9999999</LogonCount>
        <Password><Value>$p</Value><PlainText>true</PlainText></Password>
      </AutoLogon>
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add"><Order>1</Order><CommandLine>powercfg /h off</CommandLine></SynchronousCommand>
        <SynchronousCommand wcm:action="add"><Order>2</Order><CommandLine>powercfg /setactive SCHEME_MIN</CommandLine></SynchronousCommand>
        <SynchronousCommand wcm:action="add"><Order>3</Order><CommandLine>cmd /c for %d in (D E F G H I) do if exist %d:\virtio-win-guest-tools.exe start /wait %d:\virtio-win-guest-tools.exe /install /quiet /norestart</CommandLine></SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
EOF
}

unmount_disk() {
  local p
  for p in $(lsblk -lnpo NAME "$1" | tail -n +2); do
    findmnt -rn -S "$p" >/dev/null 2>&1 && { umount "$p" || die "cannot unmount $p (in use?)"; }
  done
  return 0
}

# ------------------------------------------------------------------------------- run/stop
is_running() { [[ $("${VIRSH[@]}" domstate "$1" 2>/dev/null) == running ]]; }

# The VM disk must be present AND be the same disk (GPT GUID) that create recorded.
disk_check() {
  if [[ ${DISK_TYPE:-block} == file ]]; then
    [[ -f $DISK ]] || { echo "the Windows image $DISK is missing (is its drive mounted?)"; return 1; }
    return 0
  fi
  [[ -b $DISK ]] || { echo "the Windows disk is not connected ($DISK missing)"; return 1; }
  local got; got=$(lsblk -dno PTUUID "$(readlink -f "$DISK")")
  [[ -n ${DISK_ID:-} && $got == "$DISK_ID" ]] || { echo "$DISK is not the Windows disk (GPT GUID ${got:-none}, expected ${DISK_ID:-unset})"; return 1; }
}

# ------------------------------------------------------------------------- shared drives
# While Windows runs it also gets the USB storage plugged in at start (external disks, card
# readers, optical drives) and the internal disks in PASS_DISKS. Safety: a drive is only handed
# over after the host unmounted it (else the start is aborted), the host cannot mount it while
# Windows has it, and internal disks are remounted afterwards (read-only if that fails).
usb_dev_of_block() {  # sdX -> its USB device (e.g. 2-8 or 1-13.2), or nothing
  readlink -f "/sys/block/$1" | sed -n 's|.*/\([0-9]\+-[0-9.]\+\)/[0-9]\+-[0-9.]\+:[0-9.]\+/.*|\1|p'
}
blocks_of_usb() {  # USB device dir -> its block devices (sdX, srN)
  local b; for b in "$1"/*/host*/target*/*/block/*; do [[ -e $b ]] && basename "$b"; done
}
holds_system() {  # true if a block device (or its partitions) holds / /home /boot /var
  lsblk -lno MOUNTPOINTS "/dev/$1" 2>/dev/null | grep -qxE '/|/home|/boot(/efi)?|/var|/usr'
}

shared_xml() {  # one XML element per line for every drive to pass at this start
  local windev='' winusb='' d b n=0 p letters=(e f g h i j k l m n)
  if [[ ${DISK_TYPE:-block} == block ]]; then
    windev=$(basename "$(readlink -f "$DISK")"); winusb=$(usb_dev_of_block "$windev")
  fi
  if [[ ${PASS_USB_STORAGE:-yes} == yes ]]; then
    for d in /sys/bus/usb/devices/*; do
      [[ -f $d/busnum ]] && grep -qx 08 "$d"/*/bInterfaceClass 2>/dev/null || continue
      [[ $(basename "$d") == "$winusb" ]] && continue             # the Windows disk itself
      for b in $(blocks_of_usb "$d"); do holds_system "$b" && continue 2; done
      printf "<hostdev mode='subsystem' type='usb' managed='yes'><source><address bus='%d' device='%d'/></source><alias name='ua-tuxstor-%s'/></hostdev>\n" \
        "$(<"$d/busnum")" "$(<"$d/devnum")" "$(basename "$d" | tr . _)"
    done
  fi
  for p in ${PASS_DISKS:-}; do
    [[ -b $p && $(readlink -f "$p") != "$(readlink -f "$DISK")" ]] || continue
    holds_system "$(basename "$(readlink -f "$p")")" && continue
    printf "<disk type='block' device='disk'><driver name='qemu' type='raw' cache='none' io='native'/><source dev='%s'/><target dev='sd%s' bus='sata'/><alias name='ua-tuxdisk-%d'/></disk>\n" \
      "$p" "${letters[n]}" "$n"
    n=$((n + 1))
  done
}

apply_shared() {  # replace the shared drives in the VM definition with what is connected now
  local x; x=$(mktemp)
  "${VIRSH[@]}" dumpxml --inactive "$NAME" >"$x" || { rm -f "$x"; return 1; }
  shared_xml | python3 -c '
import sys, xml.etree.ElementTree as ET
tree = ET.parse(sys.argv[1]); devs = tree.getroot().find("devices")
for e in list(devs):
    a = e.find("alias")
    if a is not None and a.get("name", "").startswith(("ua-tuxstor-", "ua-tuxdisk-")):
        devs.remove(e)
for line in sys.stdin:
    if line.strip():
        devs.append(ET.fromstring(line))
tree.write(sys.argv[1])' "$x" && "${VIRSH[@]}" define "$x" >/dev/null
  local rc=$?; rm -f "$x"; return $rc
}

cmd_start() {
  load_conf
  [[ -n $(ls /sys/kernel/iommu_groups 2>/dev/null) ]] || die "IOMMU is not active: run tux-gamevm setup and reboot"
  is_running "$NAME" && { [[ ${MODE:-single} == hybrid ]] && cmd_view; return 0; }
  is_running "$NAME-install" && die "$NAME-install is running on the same disk: shut it down first"
  local why; why=$(disk_check) || die "$why"
  apply_shared || die "could not update the shared drives"
  local shared; shared=$("${VIRSH[@]}" dumpxml --inactive "$NAME" | grep -c "name='ua-tux" || true)
  local gui=0; [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v notify-send >/dev/null && gui=1
  if [[ ${MODE:-single} == hybrid ]]; then
    ((gui)) && notify-send "Gaming VM" "Starting Windows on the NVIDIA GPU. Linux keeps running.
Right Ctrl = release keyboard/mouse, Right Ctrl+F = fullscreen." || true
    "${VIRSH[@]}" start "$NAME" || { ((gui)) && notify-send -u critical "Gaming VM" "Windows did not start: see $LOG"; exit 1; }
    ((gui)) && cmd_view
    return 0
  fi
  if ((gui)); then
    notify-send -u critical "Gaming VM" "Starting $NAME in 5 s: the desktop will close. Save your work.
$shared drive(s) go to Windows and come back after it shuts down." || true
    sleep 5
  fi
  "${VIRSH[@]}" start "$NAME"
}
# hybrid: the Looking Glass window (Windows' screen, keyboard, mouse, sound).
cmd_view() {
  load_conf
  [[ ${MODE:-single} == hybrid ]] || die "the Looking Glass window is for hybrid (laptop) setups"
  is_running "$NAME" || die "$NAME is not running (tux-gamevm start)"
  command -v looking-glass-client >/dev/null || die "looking-glass-client is not installed (tux-gamevm setup)"
  pgrep -u "$UID" -f '^looking-glass-client' >/dev/null && return 0   # name > 15 chars: -x never matches
  local i; for i in $(seq 40); do [[ -e /dev/shm/looking-glass ]] && break; sleep 0.25; done
  setsid -f looking-glass-client >/dev/null 2>&1
}
# Install/repair mode: the same Windows in a window on the Linux desktop; no GPU handover.
cmd_install() {
  load_conf
  is_running "$NAME" && die "$NAME is running on the same disk: shut it down first"
  local why; why=$(disk_check) || die "$why"
  if ! is_running "$NAME-install"; then
    "${VIRSH[@]}" start "$NAME-install"
    # A Windows ISO boots only after "Press any key to boot from CD": press it while the VM starts
    # (once Windows is on the disk this boots it instead, as the empty-disk check below shows).
    if "${VIRSH[@]}" dumpxml "$NAME-install" | grep -q "<boot order='1'/>" && ! windows_installed; then
      local i; for i in $(seq 12); do sleep 1; "${VIRSH[@]}" send-key "$NAME-install" KEY_ENTER >/dev/null 2>&1 || true; done
      # Single-edition media (LTSC) still show the edition list once even with an answer file;
      # Enter picks the only entry. Keep pressing while Setup loads (harmless on later screens).
      for i in $(seq 9); do sleep 10; "${VIRSH[@]}" send-key "$NAME-install" KEY_ENTER >/dev/null 2>&1 || true; done &
    fi
  fi
  command -v virt-viewer >/dev/null || die "virt-viewer is not installed (tux-gamevm setup installs it)"
  setsid -f virt-viewer --connect qemu:///system --wait --reconnect "$NAME-install" >/dev/null 2>&1
}
# guest-setup: run data/gamevm-guest-setup.ps1 inside the running VM through the guest agent
# (virtio guest tools, installed at first logon). Downloads and installs the Looking Glass host
# and the Virtual Display Driver in Windows; prints what it did.
cmd_guest_setup() {
  load_conf
  local dom='' d s=${TUX_SHARE:-/usr/share/tuxcraft}/data/gamevm-guest-setup.ps1
  [[ -f $s ]] || s=$(dirname "$(readlink -f "$0")")/../data/gamevm-guest-setup.ps1
  [[ -f $s ]] || die "gamevm-guest-setup.ps1 not found"
  for d in "$NAME" "$NAME-install"; do is_running "$d" && { dom=$d; break; }; done
  [[ -n $dom ]] || die "start the VM first (tux-gamevm start, or tux-gamevm install)"
  # Windows' virtual monitor gets the mode of the Linux screen the Looking Glass window is on
  # (e.g. 1920 1080 165 on a 165 Hz laptop panel); 1080p60 without a desktop to ask.
  local mode='1920 1080 60' m
  if [[ -n ${DISPLAY:-} ]] && command -v xrandr >/dev/null; then
    m=$(xrandr --current | awk '/ connected primary/ {p = 1; next} p && /\*/ {split($1, r, "x");
          for (i = 2; i <= NF; i++) if ($i ~ /\*/) { gsub(/[*+]/, "", $i); printf "%d %d %d", r[1], r[2], $i + 0.5; exit } }')
    [[ $m =~ ^[0-9]+\ [0-9]+\ [0-9]+$ ]] && mode=$m
  fi
  local w h f; read -r w h f <<<"$mode"; say "Windows screen: ${w}x${h} @ ${f} Hz"
  # shellcheck disable=SC2086  # mode is three numbers
  python3 - "$dom" "$s" $mode <<'PY'
import base64, json, subprocess, sys, time
dom, script, width, height, hz = sys.argv[1:6]
def agent(cmd, args=None):
    msg = {"execute": cmd, **({"arguments": args} if args is not None else {})}
    r = subprocess.run(["virsh", "-c", "qemu:///system", "qemu-agent-command", "--timeout", "60", dom, json.dumps(msg)],
                       capture_output=True, text=True)
    if r.returncode:
        sys.exit("guest agent: " + r.stderr.strip() + " (is Windows up, with the virtio guest tools?)")
    return json.loads(r.stdout)["return"]
def run(path, *args):
    pid = agent("guest-exec", {"path": path, "arg": list(args), "capture-output": True})["pid"]
    while not (st := agent("guest-exec-status", {"pid": pid})).get("exited"):
        time.sleep(2)
    for k in ("out-data", "err-data"):
        if st.get(k):
            sys.stdout.write(base64.b64decode(st[k]).decode("utf-8", "replace"))
    return st.get("exitcode") or 0
for _ in range(60):
    try:
        agent("guest-ping"); break
    except SystemExit:
        time.sleep(5)
run("cmd.exe", "/c", "mkdir C:\\tuxcraft 2>nul")
data = open(script, "rb").read()
h = agent("guest-file-open", {"path": "C:\\tuxcraft\\guest-setup.ps1", "mode": "wb"})
agent("guest-file-write", {"handle": h, "buf-b64": base64.b64encode(data).decode()})
agent("guest-file-close", {"handle": h})
sys.exit(run("powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\tuxcraft\\guest-setup.ps1",
             "-Width", width, "-Height", height, "-Hz", hz))
PY
}

# Does the Windows disk/image hold a partition table yet? (empty sparse image = not installed)
windows_installed() {
  if [[ ${DISK_TYPE:-block} == file ]]; then
    [[ -n $(head -c 1024 "$DISK" 2>/dev/null | tr -d '\0') ]]
  else
    [[ -n $(lsblk -no PARTTYPE "$(readlink -f "$DISK")" 2>/dev/null | tr -d '[:space:]') ]]
  fi
}
cmd_stop()   { load_conf; "${VIRSH[@]}" shutdown "$NAME"; }    # asks Windows to shut down
cmd_kill()   { load_conf; "${VIRSH[@]}" destroy "$NAME"; }     # pull the plug (Windows hung)
cmd_status() {
  load_conf
  echo "VM:    $NAME ($("${VIRSH[@]}" domstate "$NAME" 2>/dev/null || echo undefined)), mode ${MODE:-single}"
  echo "Disk:  $DISK"
  echo "GPU:   $GPU  IOMMU: $([[ -n $(ls /sys/kernel/iommu_groups 2>/dev/null) ]] && echo on || echo OFF)"
  echo "USB:   $USB"
  echo "Share: USB storage plugged in at start: ${PASS_USB_STORAGE:-yes}; internal disks: ${PASS_DISKS:-none}"
  [[ -s $NOTICE ]] && echo "Note:  $(<"$NOTICE")"
  echo "Log:   $LOG"
}
cmd_eject_iso() {
  need_root eject-iso
  load_conf
  local x d i isos=() keep
  for d in "$NAME" "$NAME-install"; do
    "${VIRSH[@]}" domstate "$d" >/dev/null 2>&1 || continue
    x=$(mktemp)
    mapfile -t -O "${#isos[@]}" isos < <("${VIRSH[@]}" dumpxml --inactive "$d" | sed -n "/device='cdrom'/,/<\/disk>/s|.*<source file='\([^']*\)'.*|\1|p")
    "${VIRSH[@]}" dumpxml --inactive "$d" | sed "/device='cdrom'/,/<\/disk>/d" >"$x"
    "${VIRSH[@]}" define "$x" >/dev/null && say "Installer CDs removed from $d"
    rm -f "$x"
  done
  # Delete only the copies create made (libvirt's image dir, or next to a disk image); the
  # unattend CD holds the Windows password. The original ISOs elsewhere stay.
  keep=/var/lib/libvirt/images; [[ ${DISK_TYPE:-block} == file ]] && keep=$(dirname "$DISK")
  for i in $(printf '%s\n' "${isos[@]}" | sort -u); do
    [[ $i == /var/lib/libvirt/images/* || $(dirname "$i") == "$keep" ]] && rm -f "$i" && say "Deleted $i"
  done
  return 0
}

# ----------------------------------------------------------------------------------- hook
dm_service() {  # the login manager to stop/start
  local s; for s in greetd lightdm sddm gdm ly; do
    if [[ $(init_system) == systemd ]]; then systemctl is-enabled "$s" >/dev/null 2>&1 && { echo "$s"; return; }
    elif [[ -e /var/service/$s ]]; then echo "$s"; return; fi
  done
}
svc() {  # svc stop|start NAME
  if [[ $(init_system) == systemd ]]; then systemctl "$1" "$2"; else sv "$1" "$2" >/dev/null; fi
}
gpu_driver_modules() {
  if lsmod | grep -q '^nvidia'; then echo "nvidia_drm nvidia_uvm nvidia_modeset nvidia"; fi
}

SHARED=/run/tux-gamevm.shared NOTICE=/run/tux-gamevm.notice
IGNORE_RULE=/run/udev/rules.d/62-tux-gamevm-shared.rules

shared_blocks() {  # domain XML on stdin -> shared block devices: sdX / srN (USB) or int:sdX
  python3 -c '
import sys, xml.etree.ElementTree as ET
for e in ET.fromstring(sys.stdin.read()).find("devices"):
    a = e.find("alias"); n = a.get("name", "") if a is not None else ""
    if n.startswith("ua-tuxstor-"):
        ad = e.find("source/address"); print("usb", int(ad.get("bus"), 0), int(ad.get("device"), 0))
    elif n.startswith("ua-tuxdisk-"):
        print("disk", e.find("source").get("dev"))' | while read -r kind a b; do
    case $kind in
      usb) local d; for d in /sys/bus/usb/devices/*; do
             [[ -f $d/busnum && $(<"$d/busnum") == "$a" && $(<"$d/devnum") == "$b" ]] && blocks_of_usb "$d"
           done ;;
      disk) echo "int:$(basename "$(readlink -f "$a")")" ;;
    esac
  done
}

release_shared() {  # unmount every shared drive; refuse (return 1) rather than force
  local e dev p ignore=''
  for e in $(<"$SHARED"); do
    dev=${e#int:}
    [[ $e == int:* ]] && ignore+="KERNEL==\"$dev*\", ENV{UDISKS_IGNORE}=\"1\""$'\n'
    for p in $(lsblk -lnpo NAME "/dev/$dev" 2>/dev/null); do
      findmnt -rn -S "$p" >/dev/null 2>&1 || continue
      sync
      if ! umount "$p" 2>/dev/null; then
        sleep 2
        umount "$p" 2>/dev/null || {
          echo "cannot unmount $p ($(findmnt -rno TARGET -S "$p")): in use by:"; fuser -vm "$p" 2>&1
          echo "not starting Windows, so nothing is shared while mounted"; return 1; }
      fi
      echo "unmounted $p for Windows"
    done
  done
  # While Windows has an internal disk, the host must not mount it (e.g. a click in Thunar).
  if [[ -n $ignore ]]; then
    mkdir -p /run/udev/rules.d
    printf '# tux-gamevm: these disks belong to Windows until it shuts down.\n%s' "$ignore" >"$IGNORE_RULE"
    udevadm control --reload
    for e in $(grep '^int:' "$SHARED"); do udevadm trigger --action=change --sysname-match="${e#int:}*"; done
    udevadm settle
  fi
}

remount_shared() {  # give internal disks back; read-only if Windows left them unclean
  [[ -f $SHARED ]] || return 0
  local e dev p uuid t
  rm -f "$IGNORE_RULE"; udevadm control --reload
  for e in $(grep '^int:' "$SHARED"); do
    dev=${e#int:}
    udevadm trigger --action=change --sysname-match="$dev*"; udevadm settle
    for p in $(lsblk -lnpo NAME "/dev/$dev" | tail -n +2); do
      uuid=$(blkid -s UUID -o value "$p" 2>/dev/null) || continue
      t=$(findmnt --fstab -no TARGET -S "UUID=$uuid" 2>/dev/null) || continue
      [[ -n $t ]] && ! findmnt -rn "$t" >/dev/null || continue
      if mount "$t" 2>/dev/null; then echo "remounted $t"
      elif mount -o ro "$t" 2>/dev/null; then
        echo "$t is mounted READ-ONLY: Windows left it unclean (Fast Startup/hibernation or a crash). Your files are safe; boot Windows and shut it down fully (powercfg /h off), then remount." | tee -a "$NOTICE"
      else
        echo "could not mount $t at all; it was not changed by Linux" | tee -a "$NOTICE"
      fi
    done
  done
  [[ -f $NOTICE ]] && chmod 644 "$NOTICE"
  rm -f "$SHARED"
}

# hybrid: Linux stays up on the iGPU; only the dGPU (and its HDMI audio) leaves.
# libvirt itself moves the PCI functions to vfio-pci (managed='yes'); this frees them first.
HYBRID_SVCS="nvidia-powerd nvidia-persistenced"
hybrid_prepare() {
  local p m s mods stopped=''
  disk_check || return 1
  rm -f "$NOTICE"
  shared_blocks <<<"${DOMXML:-}" | sort -u >"$SHARED"
  release_shared || return 1
  # X (or sway) holding the dGPU means the hybrid X config is not active: refuse, do not kill it.
  if fuser -v /dev/nvidia* 2>&1 | grep -qwE 'Xorg|X|sway|Xwayland'; then
    echo "the desktop (X) uses the NVIDIA GPU: log out and in once after 'tux-gamevm setup' (X config), then start again" | tee -a "$NOTICE"
    return 1
  fi
  for s in $HYBRID_SVCS; do
    [[ $(init_system) == systemd ]] && systemctl is-active -q "$s" 2>/dev/null && { systemctl stop "$s"; stopped+=" $s"; }
  done
  echo "${stopped# }" >/run/tux-gamevm.services
  # Apps using the dGPU (CUDA, a browser's video decoder, ...) lose it now.
  p=$(fuser /dev/nvidia* 2>/dev/null | tr -s ' ' '\n' | sort -u | tr '\n' ' ')
  [[ -n ${p// } ]] && { echo "$(date '+%F %T') prepare: stopping processes using the dGPU: $p"; fuser -k /dev/nvidia* >/dev/null 2>&1 || true; sleep 1; }
  mods=$(gpu_driver_modules)
  echo "$mods" >/run/tux-gamevm.unloaded
  for m in $mods; do modprobe -r "$m" || { echo "cannot unload $m: still in use"; return 1; }; done
  modprobe vfio-pci || return 1
  echo "$(date '+%F %T') prepare: dGPU released, Linux keeps the iGPU"
}
hybrid_release() {
  local s
  echo "$(date '+%F %T') release: giving the dGPU back to Linux"
  if grep -q nvidia /run/tux-gamevm.unloaded 2>/dev/null; then modprobe nvidia_drm || true; modprobe nvidia_uvm || true; fi
  rm -f /run/tux-gamevm.unloaded
  for s in $(cat /run/tux-gamevm.services 2>/dev/null); do systemctl start "$s" || true; done
  rm -f /run/tux-gamevm.services
  remount_shared
  echo "$(date '+%F %T') release: dGPU back"
}

hook_prepare() {
  [[ ${MODE:-single} == hybrid ]] && { hybrid_prepare; return; }
  local dm m p
  # Before touching the desktop: refuse to run Windows on a missing or different disk.
  disk_check || return 1
  rm -f "$NOTICE"
  shared_blocks <<<"${DOMXML:-}" | sort -u >"$SHARED"
  echo "$(date '+%F %T') prepare: sharing $(tr '\n' ' ' <"$SHARED")"
  dm=$(dm_service)
  echo "$(date '+%F %T') prepare: stopping ${dm:-no display manager}"
  [[ -n $dm ]] && svc stop "$dm"
  for p in $(seq 40); do pgrep -x 'Xorg|X|sway' >/dev/null || break; sleep 0.25; done
  # Audio servers hold the GPU's HDMI/DP audio and the USB audio devices.
  pkill -x 'pipewire|pipewire-pulse|wireplumber|pulseaudio' 2>/dev/null || true
  sleep 1
  release_shared || return 1
  fuser -k /dev/nvidia* >/dev/null 2>&1 || true
  for p in /sys/class/vtconsole/vtcon*/bind; do echo 0 >"$p" 2>/dev/null || true; done
  echo efi-framebuffer.0 >/sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
  local mods; mods=$(gpu_driver_modules)
  echo "$mods" >/run/tux-gamevm.unloaded
  for m in $mods; do modprobe -r "$m" || { echo "cannot unload $m: still in use"; return 1; }; done
  modprobe vfio-pci || return 1
  [[ ${DISK_TYPE:-block} == file ]] || ( unmount_disk "$(readlink -f "$DISK")" ) || return 1
  echo "$(date '+%F %T') prepare: GPU released"
}

hook_release() {
  [[ ${MODE:-single} == hybrid ]] && { hybrid_release; return; }
  echo "$(date '+%F %T') release: giving the GPU back"
  # modprobe.d options (modeset/fbdev) apply again; nvidia_drm pulls in nvidia + nvidia_modeset.
  if grep -q nvidia /run/tux-gamevm.unloaded 2>/dev/null; then modprobe nvidia_drm || true; modprobe nvidia_uvm || true; fi
  rm -f /run/tux-gamevm.unloaded
  local p; for p in /sys/class/vtconsole/vtcon*/bind; do echo 1 >"$p" 2>/dev/null || true; done
  # X switches its VT's keyboard to "off" (raw input) and, killed with the session, never switches
  # it back: the login screen then gets no key presses at all. Reset every VT that no X is using.
  if ! pgrep -x 'Xorg|X' >/dev/null && command -v kbd_mode >/dev/null; then
    for p in /dev/tty[1-9] /dev/tty1[0-2]; do [[ -c $p ]] && kbd_mode -f -u -C "$p" 2>/dev/null; done
  fi
  remount_shared
  local dm; dm=$(dm_service); [[ -n $dm ]] && svc start "$dm"
  echo "$(date '+%F %T') release: ${dm:-desktop} back"
}

cmd_hook() {  # libvirt: hook <vm> <operation> <sub-operation> ...
  [[ -f $CONF ]] || exit 0
  # shellcheck source=/dev/null
  . "$CONF"
  [[ ${1:-} == "$NAME" ]] || exit 0
  case ${2:-}/${3:-} in
    # If the handover fails, bring the desktop back instead of leaving a black screen.
    prepare/begin) DOMXML=$(cat); hook_prepare >>"$LOG" 2>&1 || { hook_release >>"$LOG" 2>&1; exit 1; } ;;
    release/end)   hook_release >>"$LOG" 2>&1 ;;
  esac
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  create) shift; cmd_create "$@" ;;
  start) cmd_start ;;
  view) cmd_view ;;
  guest-setup) cmd_guest_setup ;;
  install) cmd_install ;;
  stop) cmd_stop ;;
  kill) cmd_kill ;;
  status) cmd_status ;;
  eject-iso) cmd_eject_iso ;;
  hook) shift; cmd_hook "$@" ;;
  *) sed -n '2,/^set -euo/{/^set -euo/!p}' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
