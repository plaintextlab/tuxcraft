#!/usr/bin/env python3
# tux-hotcorner — hot corner like GNOME's: rest the mouse in the top-left corner of the screen for
# half a second and the workspace overview opens (the same grid as Super+Space); passing through
# the corner on the way to something does nothing. Rest it there again to close the overview.
# X11 sessions (dwm, i3); tux-autostart starts it. Off with HOT_CORNER=0 in ~/.config/tuxcraft/state.
#   It fires once per visit: move away from the corner before it can fire again. Not while a mouse
#   button is held (dragging a window or a file there) or while a fullscreen window has focus
#   (games, video), where the pointer often ends up in a corner.
import ctypes
import ctypes.util
import fcntl
import os
import subprocess
import sys
import time

CORNER = 1      # pixels from the edges that count as "in the corner"
REARM = 40      # pixels the pointer has to move away before the corner works again
POLL = 0.04     # seconds between pointer checks
DWELL = 0.5     # seconds the pointer has to stay in the corner
BUTTONS = 0x1F00  # Button1..5 held


def enabled():
    state = os.path.expanduser("~/.config/tuxcraft/state")
    try:
        for line in open(state):
            k, _, v = line.strip().partition("=")
            if k == "HOT_CORNER":
                return v.strip().strip("'\"") not in ("0", "off", "no", "false")
    except OSError:
        pass
    return True


def fullscreen_focused():
    """The focused window is fullscreen (EWMH: _NET_ACTIVE_WINDOW's _NET_WM_STATE)."""
    try:
        out = subprocess.run(["xprop", "-root", "_NET_ACTIVE_WINDOW"], capture_output=True, text=True).stdout
        win = out.split()[-1] if out else ""
        if not win.startswith("0x") or int(win, 16) == 0:
            return False
        st = subprocess.run(["xprop", "-id", win, "_NET_WM_STATE"], capture_output=True, text=True).stdout
        return "_NET_WM_STATE_FULLSCREEN" in st
    except (OSError, ValueError, IndexError):
        return False


def open_overview():
    # Straight to tux-overview (on dwm too, not through tux-dwm): one script less to start.
    subprocess.Popen(["tux-overview", "show"], stdin=subprocess.DEVNULL, start_new_session=True)


def main():
    if os.environ.get("WAYLAND_DISPLAY") or not os.environ.get("DISPLAY"):
        return 0
    if not enabled():
        return 0
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"tux-hotcorner.{os.getuid()}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)   # one per session
    except OSError:
        return 0

    x = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    u, i = ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int)
    x.XQueryPointer.restype = ctypes.c_int
    x.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong, u, u, i, i, i, i, ctypes.POINTER(ctypes.c_uint)]
    dpy = x.XOpenDisplay(None)
    if not dpy:
        print("tux-hotcorner: no X display", file=sys.stderr)
        return 1
    root = x.XDefaultRootWindow(dpy)
    r, c = ctypes.c_ulong(), ctypes.c_ulong()
    rx, ry, wx, wy = (ctypes.c_int() for _ in range(4))
    mask = ctypes.c_uint()
    args = (dpy, root, ctypes.byref(r), ctypes.byref(c), ctypes.byref(rx), ctypes.byref(ry),
            ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask))

    armed = True
    since = None   # when the pointer got into the corner
    # The X connection closing (logout) ends this process: Xlib's default I/O error handler exits.
    while True:
        time.sleep(POLL)
        if not x.XQueryPointer(*args):
            continue   # pointer on another X screen
        px, py = rx.value, ry.value
        if not armed:
            if px > REARM or py > REARM:
                armed = True
            continue
        if not (px < CORNER and py < CORNER):
            since = None
            continue
        if mask.value & BUTTONS:   # dragging something there: not now, and not until it leaves
            armed, since = False, None
            continue
        now = time.monotonic()
        if since is None:
            since = now
        if now - since < DWELL:
            continue
        armed, since = False, None
        if not fullscreen_focused():
            open_overview()


if __name__ == "__main__":
    sys.exit(main() or 0)
