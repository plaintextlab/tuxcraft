#!/usr/bin/env bash
# tux-lock [--see-through] — themed lock screen. X11: pixelated screenshot + i3lock (from
# debi3n blur-lock, but ~10x faster). Wayland: swaylock with the theme colours.
#   --see-through (Super+Alt+L)  lock keyboard and mouse but leave the screen as it is, so a
#        film keeps playing (xtrlock, X11 only). The cursor becomes a padlock; type your
#        password and press Enter to unlock. Falls back to the normal lock on sway or when
#        xtrlock is missing or cannot check passwords.
. "$HOME/.config/tuxcraft/colors.sh" 2>/dev/null

if [[ ${1:-} == --see-through ]]; then
  why=''
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then why="sway cannot lock without covering the screen"
  elif ! command -v xtrlock >/dev/null; then why="xtrlock is not installed"
  elif pgrep -u "$UID" -x xtrlock >/dev/null; then exit 0
  else
    notify-send -a lock -t 4000 "Keys locked" "Type your password and press Enter to unlock"
    xtrlock & p=$!
    # xtrlock exits at once when it cannot read the password hash: lock normally instead.
    sleep 1
    if kill -0 "$p" 2>/dev/null; then wait "$p"; exit 0; fi
    wait "$p"; why="xtrlock could not start (it needs to read your password hash)"
  fi
  notify-send -a lock "See-through lock unavailable" "$why — using the normal lock"
fi
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  pgrep -x swaylock >/dev/null || exec swaylock -f
fi
pgrep -x i3lock >/dev/null && exit 0
img="${XDG_RUNTIME_DIR:-/tmp}/tux-lock.png"
playerctl pause 2>/dev/null
if command -v maim >/dev/null && { command -v magick >/dev/null || command -v convert >/dev/null; }; then
  im=$(command -v magick || command -v convert)
  maim -u "$img" && "$im" "$img" -scale 5% -scale 2000% -fill "${bg:-#000000}" -colorize 35% "$img"
  i3lock -n -e -i "$img" -c "${bg#\#}" ; rm -f "$img"
else
  i3lock -n -e -c "${bg#\#}"
fi
