#!/usr/bin/env bash
# tux-nightlight on|off|toggle|apply — warm screen colours (gammastep; replaces debi3n's redshift binds).
# The night light and tux-osd's dimming below 0% brightness both live in the gamma ramps, so this
# script sets both at once. apply: redo the ramps for the current state (tux-osd calls it).
RUN=${XDG_RUNTIME_DIR:-/tmp}
STATE=$RUN/tux-nightlight   # exists while the night light is on (gammastep -O exits at once on X11)

# Dimming from tux-osd: -30 in $RUN/tux-dim -> 0.70
factor() { local d=0; [[ -s $RUN/tux-dim ]] && read -r d <"$RUN/tux-dim"; awk -v d="$d" 'BEGIN{printf "%.2f", (100 + d) / 100}'; }

apply() {
  local b o; b=$(factor)
  pkill -x gammastep
  if [[ -f $STATE ]]; then
    setsid -f gammastep -O "${TEMP:-3500}" -b "$b" -P >/dev/null 2>&1
  elif [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    # Wayland keeps the ramps only while gammastep runs.
    [[ $b != 1.00 ]] && setsid -f gammastep -O 6500 -b "$b" -P >/dev/null 2>&1
  else
    for o in $(xrandr --query | awk '/ connected/{print $1}'); do xrandr --output "$o" --gamma 1:1:1 --brightness "$b"; done
  fi
}
on()  { touch "$STATE"; apply; notify-send -u low "Night light on"; }
off() { rm -f "$STATE"; apply; notify-send -u low "Night light off"; }
case ${1:-toggle} in
  on) on ;; off) off ;;
  toggle) [[ -f $STATE ]] && off || on ;;
  apply) apply ;;
esac
