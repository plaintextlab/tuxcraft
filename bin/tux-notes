#!/usr/bin/env bash
# tux-notes [--new] — browse/create notes (.md, .txt) with fzf (from debi3n script-notes.sh).
NOTES_DIR=${NOTES_DIR:-$HOME/Notes}
EDITOR=${EDITOR:-micro}
mkdir -p "$NOTES_DIR"
if [[ ${1:-} == --new || ${1:-} == -n ]]; then
  name=$(fzf --print-query --prompt="New note name: " --header="Enter to create, Esc to cancel" --height=5 </dev/null | head -n1)
  [[ -z $name ]] && exit 0
  [[ $name == *.md || $name == *.txt ]] || name+=.md
  f="$NOTES_DIR/$name"; mkdir -p "$(dirname "$f")"; exec $EDITOR "$f"
fi
cd "$NOTES_DIR" || exit 1
sync_bind=()
[[ -x .sync ]] && sync_bind=(--bind "ctrl-s:execute(./.sync; read -n1 -r -p 'Press any key...')")
# Only real notes: .md and .txt, nothing under hidden folders (.git, .trash, .attachments) and
# no hidden files. fzf quotes {} itself, so the commands below must not add quotes around it:
# paths are relative to the notes folder, which keeps names with spaces working.
sel=$(find -L . -path '*/.*' -prune -o -type f \( -iname '*.md' -o -iname '*.txt' \) -printf '%P\n' 2>/dev/null | sort |
  fzf --height=100% --prompt="Notes > " --preview="bat --style=plain --color=always -- {} 2>/dev/null || cat -- {}" \
      --preview-window=right:60%:wrap --header="Enter: open | Ctrl-/: preview$([[ -x .sync ]] && echo ' | Ctrl-S: sync')" \
      --bind='ctrl-/:toggle-preview' "${sync_bind[@]}")
[[ -n $sel ]] && exec $EDITOR "$NOTES_DIR/$sel"
