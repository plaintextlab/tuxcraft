#!/usr/bin/env python3
"""tux-obs status|start|stop — drive OBS Studio's recording (Flatpak or native OBS).

Recording uses OBS's own settings (profile, encoder, format, folder), exactly as if
the Record button were pressed.

  status  prints "recording" or "idle"; exit 1 when OBS cannot be asked
          (not running, or its WebSocket server is off).
  start   starts recording in the running OBS; if OBS is not running, launches it
          minimised to the tray with --startrecording.
  stop    stops recording (OBS keeps running).

Talking to a running OBS needs Tools → WebSocket Server Settings → Enable. The port
and password are read from OBS's own config, so nothing has to be set up here.
Standard library only (a minimal obs-websocket v5 client).
"""
import base64, hashlib, json, os, shutil, socket, struct, subprocess, sys

HOME = os.path.expanduser("~")
CONFIGS = [
    f"{HOME}/.var/app/com.obsproject.Studio/config/obs-studio",  # Flatpak
    f"{os.environ.get('XDG_CONFIG_HOME', HOME + '/.config')}/obs-studio",
]


def ws_config():
    for d in CONFIGS:
        try:
            with open(f"{d}/plugin_config/obs-websocket/config.json") as f:
                return json.load(f)
        except (OSError, ValueError):
            continue
    return None


def obs_running():
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "obs"],
                          stdout=subprocess.DEVNULL).returncode == 0


class OBS:
    def __init__(self, port, password):
        self.s = socket.create_connection(("127.0.0.1", port), timeout=3)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET / HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\n"
                        f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: obswebsocket.json\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.s.recv(1024)
            if not chunk:
                raise ConnectionError("handshake closed")
            head += chunk
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise ConnectionError("handshake refused")
        self.buf = head.split(b"\r\n\r\n", 1)[1]
        hello = self.recv()["d"]
        ident = {"rpcVersion": 1, "eventSubscriptions": 0}
        auth = hello.get("authentication")
        if auth:
            secret = base64.b64encode(hashlib.sha256((password + auth["salt"]).encode()).digest())
            ident["authentication"] = base64.b64encode(
                hashlib.sha256(secret + auth["challenge"].encode()).digest()).decode()
        self.send({"op": 1, "d": ident})
        if self.recv().get("op") != 2:
            raise ConnectionError("not identified (wrong password?)")

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise ConnectionError("connection closed (wrong password?)")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def recv(self):
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b1 & 0x80 else None
            data = self._read(n)
            if mask:
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
            op = b0 & 0x0F
            if op == 8:
                raise ConnectionError("closed by OBS (wrong password?)")
            if op in (1, 2):
                return json.loads(data)

    def send(self, msg):
        data = json.dumps(msg).encode()
        n = len(data)
        head = bytes([0x81])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        self.s.sendall(head + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(data)))

    def request(self, kind):
        self.send({"op": 6, "d": {"requestType": kind, "requestId": kind}})
        while True:
            m = self.recv()
            if m.get("op") == 7 and m["d"].get("requestId") == kind:
                return m["d"]


def connect():
    cfg = ws_config()
    if not cfg or not cfg.get("server_enabled") or not obs_running():
        return None
    try:
        return OBS(int(cfg.get("server_port", 4455)), cfg.get("server_password", "") or "")
    except (OSError, ValueError, ConnectionError, KeyError):
        return None


def launch_recording():
    if shutil.which("flatpak") and subprocess.run(
            ["flatpak", "info", "com.obsproject.Studio"], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL).returncode == 0:
        cmd = ["flatpak", "run", "com.obsproject.Studio"]
    elif shutil.which("obs"):
        cmd = ["obs"]
    else:
        return False
    subprocess.Popen(cmd + ["--startrecording", "--minimize-to-tray"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return True


def main():
    what = sys.argv[1] if len(sys.argv) > 1 else "status"
    if what == "start" and not obs_running():
        sys.exit(0 if launch_recording() else 3)
    obs = connect()
    if obs is None:
        if what == "status":
            sys.exit(1)
        print("OBS is running but its WebSocket server is off or refused us: "
              "enable Tools → WebSocket Server Settings in OBS.", file=sys.stderr)
        sys.exit(2)
    if what == "status":
        print("recording" if obs.request("GetRecordStatus").get("responseData", {}).get("outputActive") else "idle")
    elif what in ("start", "stop"):
        r = obs.request("StartRecord" if what == "start" else "StopRecord")
        st = r.get("requestStatus", {})
        if not st.get("result"):
            print(st.get("comment") or f"OBS refused ({st.get('code')})", file=sys.stderr)
            sys.exit(4)
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(64)


if __name__ == "__main__":
    main()
