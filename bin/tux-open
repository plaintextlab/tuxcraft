#!/usr/bin/env bash
# tux-open browser|browser-private|files [DIR...]
. /etc/tuxcraft/session.conf 2>/dev/null
STATE="$HOME/.config/tuxcraft/state"; . "$STATE" 2>/dev/null
b=${BROWSER:-firefox}
[[ $b == firefox ]] && ! command -v firefox >/dev/null && command -v firefox-esr >/dev/null && b=firefox-esr
command -v "$b" >/dev/null || b=xdg-open
mode=${1:-browser}; shift || true
note() { [[ -d ${XDG_RUNTIME_DIR:-/nonexistent}/tux-warm ]] && echo "$EPOCHSECONDS $1" >>"$XDG_RUNTIME_DIR/tux-warm/notes"; }   # for tux-warm
case $mode in
  files) note thunar; exec thunar "$@" ;;
  browser) note "$(basename "$(readlink -f "$(command -v "$b")")")"; exec "$b" "$@" ;;
  browser-private)
    note "$(basename "$(readlink -f "$(command -v "$b")")")"
    case $b in firefox*) exec "$b" --private-window ;; chromium|brave*|google-chrome*) exec "$b" --incognito ;; *) exec "$b" ;; esac ;;
esac
