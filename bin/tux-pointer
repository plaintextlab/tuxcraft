#!/usr/bin/env bash
# tux-pointer — Super + drag a window to the right edge of the screen and let go: it moves to the
# next workspace and you go with it (left edge: the previous workspace). i3 session; started by
# tux-autostart.
# i3 does not report where a drag ends, so this listens to X's raw input events: they arrive
# even while i3 holds the mouse for the drag, and nothing is grabbed or changed.
set -uo pipefail
command -v xinput >/dev/null && command -v xdotool >/dev/null || exit 0
# Its own process group, so stopping it stops its helpers too: a leftover xinput keeps the mouse
# events, and X gives them to one program only, not to the next tux-pointer.
[[ $(ps -o pgid= $$ | tr -d " ") == "$$" ]] || exec setsid "$0" "$@"
lock=${XDG_RUNTIME_DIR:-/tmp}/tux-pointer.$UID.lock
exec 9>"$lock"; flock -n 9 || exit 0   # one per session
trap 'trap - TERM INT HUP EXIT; kill 0 2>/dev/null' TERM INT HUP EXIT

# Keycodes of the Super keys (133/134 on every evdev keyboard map).
supers=$(xmodmap -pke 2>/dev/null | awk '/Super_[LR]/ { print $2 }' | tr '\n' ' ')
supers=${supers:-133 134}
EDGE=3   # pixels from the screen edge that count as "at the edge"

on_drop() {  # Super + drag ended: next / previous workspace when the pointer is at the screen's edge
  local X Y SCREEN WINDOW sw sh n cur
  eval "$(xdotool getmouselocation --shell 2>/dev/null)" || return
  read -r sw sh < <(xdotool getdisplaygeometry 2>/dev/null) || return
  cur=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .num')
  [[ $cur =~ ^[0-9]+$ ]] || return
  if ((X >= sw - EDGE)); then n=$((cur + 1)); ((n > 10)) && return
  elif ((X <= EDGE - 1)); then n=$((cur - 1)); ((n < 1)) && return
  else return; fi
  i3-msg -q "move container to workspace number $n, workspace number $n" >/dev/null 2>&1
}

super=0 dragging=0
# xinput prints every event over several lines; awk keeps the key and button ones as
# "type detail" (13/14 key press/release, 15/16 button press/release).
# Neither keeps the lock fd: left running after this script is killed, they would block the next one.
xinput test-xi2 --root 2>/dev/null 9>&- | awk '
  /^EVENT type/ { t = $3; next }
  /detail:/ && t >= 13 && t <= 16 { print t, $2; fflush() }' 9>&- |
while read -r type detail; do
  case $type in
    13) [[ " $supers " == *" $detail "* ]] && super=1 ;;
    14) [[ " $supers " == *" $detail "* ]] && super=0 ;;
    15) [[ $detail == 1 ]] && dragging=$super ;;
    16) [[ $detail == 1 ]] || continue
        ((dragging && super)) && on_drop
        dragging=0 ;;
  esac
done &
wait   # (in the background: a signal is handled at once, not after the next mouse event)
