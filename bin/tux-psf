#!/usr/bin/env python3
"""tux-psf FONTFILE PX OUT.psf — render a TrueType/OpenType font as a PSF2 console font.
tux-psf --pf2 FONTFILE PX OUT.pf2 — the same letters as a GRUB (PFF2) font, named "tuxcraft".

The Linux console (and tuigreet on it) only draws bitmap PSF fonts, so tux-font uses this to
give the login screen the desktop's font; GRUB draws only its own PF2 bitmaps, so the boot
menu gets them the same way (no grub-mkfont needed, Void does not ship it). PX is the cell
height in pixels (12-32 for PSF, 12-64 for PF2). Covers ASCII, Latin-1, box drawing and
blocks (tuigreet's borders, GRUB's terminal box) and a little punctuation.
"""
import struct
import sys

from PIL import Image, ImageDraw, ImageFont

RANGES = [(0x20, 0x7E), (0xA0, 0xFF), (0x2500, 0x259F)]
EXTRA = "‘’“”•…–—€←↑→↓✓✗▲▶▼◀●○◆"
THRESHOLD = 96       # antialiased coverage (0-255) that counts as an "on" pixel


def codepoints():
    cps = [0]  # glyph 0 stays blank: the console shows it for anything not in the table
    for lo, hi in RANGES:
        cps.extend(range(lo, hi + 1))
    cps.extend(ord(c) for c in EXTRA if ord(c) not in cps)
    return cps


def slots():
    """PSF glyph positions: exactly 512 (the kernel refuses any other count but 256), with
    0-255 at their own code, Latin-1 style, and box drawing and the rest after them. setfont
    insists position 32 (space, which the console clears the screen with) is blank, so glyphs
    cannot simply be packed one after another. Control codes stay blank and unmapped."""
    s = [cp if 0x20 <= cp <= 0x7E or cp >= 0xA0 else None for cp in range(256)]
    s += [cp for cp in codepoints() if cp > 0xFF]
    assert len(s) <= 512
    return s + [None] * (512 - len(s))


def fit(path, px):
    """Font object whose ascent+descent fills PX rows."""
    size = px
    for _ in range(6):
        font = ImageFont.truetype(path, size)
        asc, desc = font.getmetrics()
        if asc + desc == px:
            break
        size = max(4, round(size * px / (asc + desc)))
    font = ImageFont.truetype(path, size)
    return font, font.getmetrics()[0]


def render(path, px):
    font, ascent = fit(path, px)
    width = max(4, min(32, round(font.getlength("M"))))
    rowbytes = (width + 7) // 8
    glyphs, table = [], []
    for cp in slots():
        img = Image.new("L", (width, px), 0)
        if cp is not None:
            ImageDraw.Draw(img).text((0, ascent), chr(cp), font=font, fill=255, anchor="ls")
        data = bytearray()
        pix = img.load()
        for y in range(px):
            row = 0
            for x in range(width):
                if pix[x, y] >= THRESHOLD:
                    row |= 0x80 >> (x % 8) << (8 * (rowbytes - 1 - x // 8))
            data += row.to_bytes(rowbytes, "big")
        glyphs.append(bytes(data))
        table.append((chr(cp).encode() if cp is not None else b"") + b"\xff")
    header = struct.pack("<8I", 0x864AB572, 0, 32, 1, len(glyphs), px * rowbytes, px, width)
    return header + b"".join(glyphs) + b"".join(table), width


def section(tag, data):
    return tag + struct.pack(">I", len(data)) + data


def render_pf2(path, px, name="tuxcraft"):
    """GRUB PFF2: header sections, a sorted character index, then 1-bit glyph bitmaps (rows
    packed without padding). Each glyph is one full cell: offset_y = -descent puts its bottom
    edge on the descent line, so every line is exactly PX tall."""
    font, ascent = fit(path, px)
    descent = px - ascent
    cells = []
    for cp in sorted(codepoints()[1:]):  # GRUB needs the index in ascending order
        width = round(font.getlength(chr(cp)))
        if width < 1:
            continue
        img = Image.new("L", (width, px), 0)
        ImageDraw.Draw(img).text((0, ascent), chr(cp), font=font, fill=255, anchor="ls")
        pix = img.load()
        bits = [1 if pix[x, y] >= THRESHOLD else 0 for y in range(px) for x in range(width)]
        data = bytearray((len(bits) + 7) // 8)
        for i, b in enumerate(bits):
            if b:
                data[i // 8] |= 0x80 >> (i % 8)
        cells.append((cp, struct.pack(">HHhhh", width, px, 0, -descent, width) + bytes(data)))
    maxw = max(struct.unpack(">H", g[:2])[0] for _, g in cells)
    head = (section(b"FILE", b"PFF2") + section(b"NAME", name.encode() + b"\0")
            + section(b"FAMI", name.encode() + b"\0") + section(b"WEIG", b"normal\0")
            + section(b"SLAN", b"normal\0") + section(b"PTSZ", struct.pack(">H", px))
            + section(b"MAXW", struct.pack(">H", maxw)) + section(b"MAXH", struct.pack(">H", px))
            + section(b"ASCE", struct.pack(">H", ascent)) + section(b"DESC", struct.pack(">H", descent)))
    index_len = 8 + 9 * len(cells)
    offset = len(head) + index_len + 8  # glyph data starts after the DATA section header
    index, glyphs = b"", b""
    for cp, g in cells:
        index += struct.pack(">IBI", cp, 0, offset + len(glyphs))
        glyphs += g
    return head + section(b"CHIX", index) + b"DATA" + b"\xff\xff\xff\xff" + glyphs, len(cells)


def main():
    args = sys.argv[1:]
    pf2 = bool(args) and args[0] == "--pf2"
    if pf2:
        args = args[1:]
    if len(args) != 3:
        sys.exit(__doc__.strip().splitlines()[0])
    path, px, out = args[0], int(args[1]), args[2]
    if pf2:
        if not 12 <= px <= 64:
            sys.exit("tux-psf: PX must be 12-64")
        blob, n = render_pf2(path, px)
        with open(out, "wb") as f:
            f.write(blob)
        print(f"{out}: GRUB font 'tuxcraft', {px}px, {n} glyphs")
        return
    if not 12 <= px <= 32:
        sys.exit("tux-psf: PX must be 12-32")
    blob, width = render(path, px)
    with open(out, "wb") as f:
        f.write(blob)
    print(f"{out}: {width}x{px}, {len(slots())} glyphs")


if __name__ == "__main__":
    main()
