#!/usr/bin/env bash
# tux-term [--class NAME] [--title TITLE] [--working-directory DIR] [-e CMD ARGS...]  — the terminal,
# whichever it is. Takes Alacritty-style arguments, and st's (-c NAME, -t TITLE, -d DIR) too, also
# as --opt=VALUE, and starts the configured terminal:
#   kitty (default: shows real images — album art in rmpc, previews in yazi, `img photo.jpg`)
#   st (fast and light; images as sixel: yazi, chafa — built by tux-dwm), alacritty, foot
# Choose with TERMINAL=alacritty in ~/.config/tuxcraft/state (then log out and in, or just use it).
state="$HOME/.config/tuxcraft/state"
want=$(sed -n 's/^TERMINAL=//p' "$state" 2>/dev/null | tr -d "\"'")
class='' title='' dir='' cmd=()
while (($#)); do
  case $1 in
    --class|--app-id|-c) class=$2; shift ;;
    --title|-t|-T) title=$2; shift ;;
    --working-directory|--directory|--cd|-d) dir=$2; shift ;;
    --class=*|--app-id=*) class=${1#*=} ;;
    --title=*) title=${1#*=} ;;
    --working-directory=*|--directory=*|--cd=*) dir=${1#*=} ;;
    -e) shift; cmd=("$@"); break ;;
    *) cmd=("$@"); break ;;
  esac; shift
done

for t in ${want:-kitty} kitty st alacritty foot xterm; do command -v "$t" >/dev/null && break; done
# tux-warm (fast app start) keeps `alacritty --daemon` running: a window from it opens
# at once. Falls through to a normal start if that daemon is not there.
sock=${XDG_RUNTIME_DIR:-/nonexistent}/tux-warm/alacritty.sock
if [[ $t == alacritty && -S $sock ]] &&
   alacritty msg --socket "$sock" create-window ${class:+--class "$class"} ${title:+--title "$title"} --working-directory "${dir:-$PWD}" ${cmd[0]:+-e "${cmd[@]}"} 2>/dev/null; then
  exit 0
fi
case $t in
  # One kitty process for all windows (--single-instance): a new window opens in a few ms
  # instead of starting kitty from scratch each time.
  kitty)     exec kitty --single-instance --instance-group tuxcraft ${class:+--class "$class"} ${title:+--title "$title"} ${dir:+--directory "$dir"} "${cmd[@]}" ;;
  # st: no --directory option, so it starts in the folder it is started from.
  st)        [[ -n $dir ]] && { cd "$dir" || exit; }; exec st ${class:+-c "$class"} ${title:+-t "$title"} ${cmd[0]:+-e "${cmd[@]}"} ;;
  alacritty) exec alacritty ${class:+--class "$class"} ${title:+--title "$title"} ${dir:+--working-directory "$dir"} ${cmd[0]:+-e "${cmd[@]}"} ;;
  foot)      exec foot ${class:+--app-id "$class"} ${title:+--title "$title"} ${dir:+--working-directory "$dir"} "${cmd[@]}" ;;
  *)         [[ -n $dir ]] && { cd "$dir" || exit; }; exec xterm ${class:+-class "$class"} ${title:+-T "$title"} ${cmd[0]:+-e "${cmd[@]}"} ;;
esac
