#!/usr/bin/env bash
# tux-theme — one palette, applied to every app.
#   tux-theme                 pick a theme (menu)
#   tux-theme set <name>      switch theme
#   tux-theme apply           re-render configs from the current state (after editing a palette)
#   tux-theme list | current
# Custom palettes: drop a <name>.theme file in ~/.config/tuxcraft/themes/ (copy one from
# /usr/share/tuxcraft/themes/ as a starting point).
set -euo pipefail

SHARE=${TUX_SHARE:-/usr/share/tuxcraft}
CONF="$HOME/.config/tuxcraft"
STATE="$CONF/state"

THEME=gruvbox FONT="JetBrainsMono Nerd Font" TERM_FONT="JetBrainsMono Nerd Font"
FONT_SIZE=11 TERM_FONT_SIZE=12 WALLPAPER=theme BROWSER=firefox
# shellcheck source=/dev/null
[[ -f $STATE ]] && . "$STATE"

theme_file() {
  local f
  for f in "$CONF/themes/$1.theme" "$SHARE/themes/$1.theme"; do [[ -f $f ]] && { echo "$f"; return 0; }; done
  return 1
}

list_themes() {
  { ls "$SHARE/themes" "$CONF/themes" 2>/dev/null || true; } | sed -n 's/\.theme$//p' | sort -u
}

state_set() {  # state_set KEY VALUE
  mkdir -p "$CONF"; touch "$STATE"
  if grep -q "^$1=" "$STATE"; then sed -i "s|^$1=.*|$1=\"$2\"|" "$STATE"; else echo "$1=\"$2\"" >>"$STATE"; fi
}

render() {
  local tf; tf=$(theme_file "$THEME") || { echo "Unknown theme: $THEME" >&2; exit 1; }
  local sedf; sedf=$(mktemp)
  (
    # shellcheck source=/dev/null
    . "$tf"
    if [[ $variant == light ]]; then
      gtk_theme=adw-gtk3 icon_theme=Papirus-Light prefer_dark=0 color_scheme=prefer-light
    else
      gtk_theme=adw-gtk3-dark icon_theme=Papirus-Dark prefer_dark=1 color_scheme=prefer-dark
    fi
    theme=$THEME theme_name=$name home=$HOME
    font=$FONT term_font=$TERM_FONT font_size=$FONT_SIZE term_font_size=$TERM_FONT_SIZE
    keys=(bg bg_dark bg_alt bg_hl fg fg_dim muted accent accent_fg red orange yellow green cyan blue magenta)
    for i in $(seq 0 15); do keys+=("color$i"); done
    esc() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }
    for k in "${keys[@]}"; do
      printf 's|{{%s}}|%s|g\n' "$k" "$(esc "${!k}")"
      printf 's|{{%s_raw}}|%s|g\n' "$k" "$(esc "${!k#\#}")"
    done
    for k in theme theme_name variant home font term_font font_size term_font_size gtk_theme icon_theme prefer_dark color_scheme papirus; do
      printf 's|{{%s}}|%s|g\n' "$k" "$(esc "${!k}")"
    done
  ) >"$sedf"

  local tpl rel out
  while IFS= read -r -d '' tpl; do
    rel=${tpl#"$SHARE/templates/"}
    out="$HOME/$rel"
    mkdir -p "$(dirname "$out")"
    sed -f "$sedf" "$tpl" >"$out.tux-tmp" && mv "$out.tux-tmp" "$out"
  done < <(find "$SHARE/templates" -type f -print0)
  rm -f "$sedf"
}

# Push settings to running apps. Silent no-ops outside a graphical session.
reload_all() {
  [[ -n ${TUX_NO_RELOAD:-} ]] && return 0
  local tf; tf=$(theme_file "$THEME")
  # shellcheck source=/dev/null
  local variant; variant=$(. "$tf"; echo "$variant")
  if command -v gsettings >/dev/null && [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    local gi=org.gnome.desktop.interface
    if [[ $variant == light ]]; then
      gsettings set $gi gtk-theme adw-gtk3; gsettings set $gi icon-theme Papirus-Light
      gsettings set $gi color-scheme prefer-light
    else
      gsettings set $gi gtk-theme adw-gtk3-dark; gsettings set $gi icon-theme Papirus-Dark
      gsettings set $gi color-scheme prefer-dark
    fi
    gsettings set $gi font-name "$FONT $FONT_SIZE"
    gsettings set $gi monospace-font-name "$TERM_FONT $TERM_FONT_SIZE"
    gsettings set $gi cursor-theme Adwaita
  fi 2>/dev/null || true
  pkill -HUP -x xsettingsd 2>/dev/null || true
  [[ -n ${DISPLAY:-} ]] && command -v xrdb >/dev/null && xrdb -merge "$HOME/.Xresources" 2>/dev/null
  if [[ -n ${SWAYSOCK:-} ]]; then
    swaymsg reload >/dev/null 2>&1 || true
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
  elif pgrep -x i3 >/dev/null; then
    i3-msg reload >/dev/null 2>&1 || true
    pgrep -x polybar >/dev/null && "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  if pgrep -x dunst >/dev/null; then
    dunstctl reload 2>/dev/null || { pkill -x dunst; setsid -f dunst >/dev/null 2>&1; }
  fi
  [[ $WALLPAPER == theme ]] && tux-wallpaper theme >/dev/null 2>&1 || true
  # Login screen, TTY palette and icon folder colours (needs root; allowed via sudoers rule)
  sudo -n /usr/local/bin/tux-theme-system "$THEME" >/dev/null 2>&1 || true
  notify-send -a tuxcraft "Theme" "$(. "$tf"; echo "$name") applied" 2>/dev/null || true
}

menu() {
  local cur choice
  cur=$THEME
  choice=$(list_themes | sed "s/^$cur\$/$cur  (current)/" | tux-menu "theme") || exit 0
  choice=${choice%%  (current)}
  [[ -n $choice ]] && "$0" set "$choice"
}

case ${1:-} in
  set)      theme_file "${2:?theme name}" >/dev/null || { echo "Unknown theme '$2'. Try: tux-theme list" >&2; exit 1; }
            THEME=$2; state_set THEME "$2"; render; reload_all ;;
  apply)    render; reload_all ;;
  list)     list_themes ;;
  current)  echo "$THEME" ;;
  --menu|"") menu ;;
  -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        theme_file "$1" >/dev/null && exec "$0" set "$1"; echo "Unknown command/theme: $1" >&2; exit 1 ;;
esac
