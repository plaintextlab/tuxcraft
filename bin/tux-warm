#!/usr/bin/env bash
# tux-warm : faster starts for the everyday apps (browser, terminal, file manager). Keeps their
# program files in the page cache (plain reads: reclaimable, never locked) and the terminal's
# and Thunar's light server modes running. Backs off when memory is tight or a big app runs.
#   tux-warm off | on | toggle  switch it off (stays off after login) / back on
#   tux-warm status             what is kept warm, how much of it is in RAM, memory guard
#   tux-warm now                warm up now (still obeys the memory guard)
#   tux-warm --edit             edit ~/.config/tuxcraft/warm.conf (written on first use)
#   tux-warm daemon [i3|sway]   the background part (tux-autostart starts it; one per user)
conf=${XDG_CONFIG_HOME:-$HOME/.config}/tuxcraft/warm.conf
st=${XDG_STATE_HOME:-$HOME/.local/state}/tuxcraft
rt=${XDG_RUNTIME_DIR:-/tmp/tux-$UID}/tux-warm
MEMINFO=${TUX_WARM_MEMINFO:-/proc/meminfo} PSIFILE=${TUX_WARM_PSI:-/proc/pressure/memory}   # tests
HELPER_APPS="kitty alacritty thunar"

write_default() {
  mkdir -p "${conf%/*}"
  cat >"$conf" <<'EOF'
# tuxcraft fast app start (tux-warm). Read again every 30 s, so edits apply right away.
ENABLED=1             # 0 = off (or: tux-warm off / system menu → Fast app start)
# Apps kept warm. browser, terminal and files mean the ones tuxcraft starts (BROWSER and
# TERMINAL in ~/.config/tuxcraft/state, Thunar); add any program by name, e.g. "... code gimp"
APPS="browser terminal files"
HELPERS=1             # also keep the terminal's and Thunar's server mode running (8 GB RAM and up)

# Warmed files are ordinary page cache: the kernel drops them first when a program needs the
# RAM; nothing is locked in memory. Warming pauses, and idle server modes stop, while:
MIN_AVAIL_PCT=25      # MemAvailable is below this share of RAM ...
MIN_AVAIL_MB=2048     # ... or below this many MB
PSI_MAX=0.50          # memory pressure (/proc/pressure/memory "some avg10", %) is above this
# a big program or game runs (regex on the program name or path)
HEAVY="steam|steamwebhelper|gamescope|qemu-system-[^ ]*|resolve|blender|wineserver|obs|kdenlive"
EOF
}
load_conf() {
  ENABLED=1 APPS='browser terminal files' HELPERS=1 MIN_AVAIL_PCT=25 MIN_AVAIL_MB=2048 PSI_MAX=0.50
  HEAVY='steam|gamescope|qemu-system-[^ ]*|resolve'
  [[ -f $conf ]] || write_default
  # shellcheck source=/dev/null
  . "$conf"
}
log() { mkdir -p "$st"; printf '%(%F %T)T %s\n' -1 "$*" >>"$st/warm.log"; }

# ---- memory guard: sets mem_total avail (kB) and why (empty = all clear) ----------------------
guard() {
  local k v _ psi=0 floor heavy max
  mem_total=0 avail=0 why=''
  while read -r k v _; do case $k in MemTotal:) mem_total=$v ;; MemAvailable:) avail=$v ;; esac; done <"$MEMINFO"
  floor=$(( mem_total * MIN_AVAIL_PCT / 100 )); (( floor < MIN_AVAIL_MB * 1024 )) && floor=$(( MIN_AVAIL_MB * 1024 ))
  # "some avg10=1.23 ..." -> 123 (hundredths of a percent), PSI_MAX likewise
  [[ -r $PSIFILE ]] && { read -r _ v _ <"$PSIFILE"; v=${v#avg10=}; psi=$(( 10#${v%.*} * 100 + 10#${v#*.} )); }
  v=${PSI_MAX}.00; v=${v#*.}; max=$(( 10#${PSI_MAX%%.*} * 100 + 10#${v:0:2} ))
  if (( avail < floor )); then why="low memory ($((avail / 1024)) MB available)"
  elif (( psi > max )); then why="memory pressure ($((psi / 100)).$((psi % 100 / 10))%)"
  # by the program on the command line: some programs rename their process (Resolve shows up as "GUI Thread")
  elif heavy=$(pgrep -a -f "^([^ ]*/)?($HEAVY)( |$)" | head -n1) && [[ -n $heavy ]]; then
    heavy=${heavy#* }; heavy=${heavy%% *}; why="big program running: ${heavy##*/}"
  fi
  [[ -z $why ]]
}

# ---- what to warm ----------------------------------------------------------------------------
state_get() { sed -n "s/^$1=//p" "$HOME/.config/tuxcraft/state" 2>/dev/null | tr -d "\"'" | tail -n1; }
term_choice() {   # the terminal tux-term starts
  local t want; want=$(state_get TERMINAL)
  for t in ${want:-kitty} kitty alacritty foot xterm; do command -v "$t" >/dev/null && { term=$t; return; }; done
  term=xterm
}
app_program() {   # browser / terminal / files / any program name -> program name
  local b
  case $1 in
    browser)
      b=$(state_get BROWSER); b=${b:-firefox}
      [[ $b == firefox ]] && ! command -v firefox >/dev/null && command -v firefox-esr >/dev/null && b=firefox-esr
      echo "$b" ;;
    terminal) term_choice; echo "$term" ;;
    files) echo thunar ;;
    *) echo "$1" ;;
  esac
}
# The program, its libraries and, for apps with their own folder (/usr/lib/firefox, /opt/...,
# /usr/lib/kitty), the files in that folder.
app_files() {
  local p e d
  p=$(command -v "$1") || return 1
  e=$(readlink -f "$p")
  echo "$e"
  ldd "$e" 2>/dev/null | awk '$3 ~ /^\// {print $3} $1 ~ /^\// {print $1}'
  for d in "${e%/*}" "/usr/lib/$1" "/usr/lib64/$1" "/opt/$1"; do
    case $d in /usr/bin|/bin|/usr/sbin|/sbin|/usr/local/bin) continue ;; esac
    [[ -d $d ]] && find "$d" -maxdepth 3 -type f -size -512M 2>/dev/null
  done
}
# What every desktop app loads at start besides its own libraries: the OpenGL/Vulkan driver
# (Mesa's libgallium + LLVM; dlopen()ed, so ldd does not list it), font and icon caches, the
# locale archive. Warmed first; most of the cold-start time of a small app is here.
shared_files() {
  local d f t
  for d in /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu; do
    for f in "$d"/libgallium*.so* "$d"/dri/*.so "$d"/libvulkan_*.so; do
      [[ -f $f ]] || continue
      echo "$f"; ldd "$f" 2>/dev/null | awk '$3 ~ /^\// {print $3}'
    done
  done
  find "${XDG_CACHE_HOME:-$HOME/.cache}/fontconfig" /var/cache/fontconfig -maxdepth 1 -type f 2>/dev/null
  t=$(sed -n 's/^gtk-icon-theme-name *= *//p' "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" 2>/dev/null)
  for d in ${t:+"$t"} hicolor Adwaita; do [[ -f /usr/share/icons/$d/icon-theme.cache ]] && echo "/usr/share/icons/$d/icon-theme.cache"; done
  for f in /usr/lib/locale/locale-archive "${XDG_CACHE_HOME:-$HOME/.cache}/mesa_shader_cache/index"; do [[ -f $f ]] && echo "$f"; done
}
# Each file once (Mesa's dri/*.so are often hard links of one big file).
unique_files() { xargs -d '\n' -r stat -Lc '%d:%i %n' -- 2>/dev/null | awk '!seen[$1]++ { sub(/^[^ ]* /, ""); print }'; }
# Read the files (to /dev/null) at idle disk and CPU priority: afterwards they are in the page
# cache. At most 10% of RAM in total; stops early if the guard trips.
warm_round() {
  local a prog list kb total=0
  load_conf; (( ENABLED )) || return 0
  guard || { log "warm skipped: $why"; return 1; }
  for a in desktop $APPS; do
    if [[ $a == desktop ]]; then prog=desktop; mapfile -t list < <(shared_files | unique_files)
    else prog=$(app_program "$a"); mapfile -t list < <(app_files "$prog" | unique_files); fi
    ((${#list[@]})) || continue
    kb=$(du -cLk -- "${list[@]}" 2>/dev/null | tail -n1 | cut -f1)
    (( total + kb > mem_total / 10 )) && { log "warm: $prog skipped (over 10% of RAM)"; continue; }
    guard || { log "warm stopped before $prog: $why"; return 1; }
    ionice -c3 nice -n19 cat -- "${list[@]}" >/dev/null 2>&1 9>&-
    total=$(( total + kb ))
  done
  log "warm: shared desktop files + $APPS ($((total / 1024)) MB)"
}

# ---- server modes: a new window appears at once --------------------------------------------
wm_has() {   # wm_has REGEX : some window's class/app_id matches (case-insensitive)
  local tree
  if [[ -n ${SWAYSOCK:-} ]]; then tree=$(swaymsg -t get_tree 2>/dev/null); else tree=$(i3-msg -t get_tree 2>/dev/null); fi
  [[ -n $tree ]] || return 0    # cannot tell: assume yes, never close someone's window
  grep -qiE "\"(class|app_id)\": ?\"($1)\"" <<<"$tree"
}
helper_idle() {   # the server mode holds none of your windows
  local kids; kids=$(pgrep -cP "$2")
  case $1 in
    kitty) (( kids <= 1 )) ;;     # just the hidden window's "sleep"
    alacritty) (( kids == 0 )) ;; # every window runs a shell
    thunar) ! wm_has thunar ;;
  esac
}
helper_alive() { [[ -f $rt/helper.$1 ]] && kill -0 "$(<"$rt/helper.$1")" 2>/dev/null; }
helper_find() {   # PID of our server mode NAME (not the short-lived setsid parent)
  local m v
  case $1 in
    kitty) m='--instance-group tuxcraft --start-as=hidden' ;;
    alacritty) m="--daemon --socket $rt/alacritty.sock" ;;
    thunar) m='^[^ ]*thunar --daemon' ;;
  esac
  for v in $(pgrep -u "$UID" -f -- "$m"); do [[ $(</proc/"$v"/comm) != setsid ]] 2>/dev/null && { echo "$v"; return 0; }; done
  return 1
}
helper_start() {
  local name=$1 pid v i
  helper_alive "$name" && return
  if ! pid=$(helper_find "$name"); then
    case $name in
      kitty)
        # --start-as=hidden needs kitty 0.42+. Only while no kitty of ours runs: tux-term's
        # windows already share that one (--single-instance), and it would get a hidden window.
        v=$(kitty --version 2>/dev/null | awk '{print $2}')
        [[ $(printf '%s\n0.42\n' "$v" | sort -V | head -1) == 0.42 ]] || return
        pgrep -u "$UID" -x kitty >/dev/null && return
        setsid -f kitty --single-instance --instance-group tuxcraft --start-as=hidden sleep infinity >/dev/null 2>&1 9>&- ;;
      alacritty)
        rm -f "$rt/alacritty.sock"
        setsid -f alacritty --daemon --socket "$rt/alacritty.sock" >/dev/null 2>&1 9>&- ;;
      thunar)
        pgrep -u "$UID" -ix thunar >/dev/null && return    # runs already (daemon or window)
        setsid -f thunar --daemon >/dev/null 2>&1 9>&- ;;
      *) return ;;
    esac
    # setsid -f: own session, so it outlives a tux-warm restart (which finds it again).
    for ((i = 0; i < 20; i++)); do sleep 0.25; pid=$(helper_find "$name") && break; done
    [[ -n $pid ]] || { log "$name server mode did not start"; return; }
  fi
  echo "$pid" >"$rt/helper.$name"; log "$name server mode started ($pid)"
}
helper_stop() {   # helper_stop NAME [force]
  local name=$1 pid
  helper_alive "$name" || { rm -f "$rt/helper.$name"; return 0; }
  pid=$(<"$rt/helper.$name")
  [[ ${2:-} == force ]] || helper_idle "$name" "$pid" || return 0   # in use: try again later
  case $name in
    thunar) thunar -q 2>/dev/null || kill "$pid" 2>/dev/null ;;
    kitty) pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null ;;
    *) kill "$pid" 2>/dev/null ;;
  esac
  rm -f "$rt/helper.$name"; [[ $name == alacritty ]] && rm -f "$rt/alacritty.sock"
  log "$name server mode stopped (${why:-not wanted})"
}
helpers_update() {   # after guard(): $why says whether memory is fine
  local name want=' ' a
  if (( ENABLED && HELPERS && mem_total >= 8 * 1048576 * 9 / 10 )) && [[ -z $why ]] && (( EPOCHSECONDS - bad_since >= 120 )); then
    for a in $APPS; do
      case $a in terminal) term_choice; want+="$term " ;; files|thunar) want+="thunar " ;; kitty|alacritty) want+="$a " ;; esac
    done
  fi
  for name in $HELPER_APPS; do
    # an alacritty daemon whose socket is gone (after "off") takes no new windows: replace it once idle
    [[ $name == alacritty && ! -S $rt/alacritty.sock ]] && helper_alive alacritty && helper_stop alacritty
    if [[ $want == *" $name "* ]]; then helper_start "$name"; else helper_stop "$name"; fi
  done
}

# ---- daemon ----------------------------------------------------------------------------------
daemon() {
  local wm=${1:-} wm_pid='' next n busy tick=${TUX_WARM_TICK:-30}
  mkdir -p "$rt"
  exec 9>"$rt/lock"; flock -n 9 || exit 0
  trap 'why="tux-warm stopped"; for n in $HELPER_APPS; do helper_stop "$n"; done; exit 0' TERM INT HUP
  load_conf; (( ENABLED )) || exit 0
  [[ -n $wm ]] && { wm_pid=$(pgrep -n -u "$UID" -x "$wm") || exit 0; }
  log "started"; bad_since=0; next=$(( EPOCHSECONDS + ${TUX_WARM_FIRST:-60} ))   # not during login
  while [[ -z $wm_pid ]] || kill -0 "$wm_pid" 2>/dev/null; do
    sleep "$tick" 9>&- & wait $!
    load_conf
    if (( ! ENABLED )); then   # switched off: wait until no server mode holds a window, then quit
      why="switched off" busy=''
      for n in $HELPER_APPS; do helper_stop "$n"; helper_alive "$n" && busy=1; done
      [[ -n $busy ]] && continue
      log "stopped: switched off"; return
    fi
    guard || bad_since=$EPOCHSECONDS
    helpers_update
    if (( EPOCHSECONDS >= next )); then
      (( EPOCHSECONDS - bad_since >= 120 )) && warm_round
      next=$(( EPOCHSECONDS + ${TUX_WARM_ROUND:-600} ))
    fi
  done
  why="session ended"; for n in $HELPER_APPS; do helper_stop "$n" force; done; log "stopped: session ended"
}
running() { [[ -f $rt/lock ]] && ! flock -n "$rt/lock" true; }
switch() {   # switch 0|1
  local n wm busy=''
  load_conf
  if grep -q '^ENABLED=' "$conf"; then sed -i "s/^ENABLED=[0-9]*/ENABLED=$1/" "$conf"; else echo "ENABLED=$1" >>"$conf"; fi
  if (( $1 )); then
    if ! running; then
      if [[ -n ${SWAYSOCK:-} ]]; then wm=sway; elif pgrep -u "$UID" -x i3 >/dev/null; then wm=i3; fi
      setsid -f tux-warm daemon ${wm:+"$wm"} >/dev/null 2>&1
    fi
    echo "tux-warm: on"; notify-send -t 3000 "Fast app start" "On" 2>/dev/null
  else
    # Idle server modes close now; one holding your windows takes no new ones and closes with
    # its last window (the daemon waits for that, then exits).
    why="switched off"
    for n in $HELPER_APPS; do helper_stop "$n"; helper_alive "$n" && busy+=" $n"; done
    rm -f "$rt/alacritty.sock"
    echo "tux-warm: off${busy:+ (still open with your windows:$busy; closes with the last one)}"
    notify-send -t 4000 "Fast app start" "Off" 2>/dev/null
  fi
  return 0
}
status() {
  local a prog list kb res pct h
  load_conf
  if (( ! ENABLED )); then echo "tux-warm: off (tux-warm on, or system menu → Fast app start)"
  elif running; then echo "tux-warm: on"; else echo "tux-warm: on, but not running (starts at login)"; fi
  if guard; then echo "  memory guard: all clear"; else echo "  memory guard: paused — $why"; fi
  for a in desktop $APPS; do
    if [[ $a == desktop ]]; then prog='(shared)'; mapfile -t list < <(shared_files | unique_files)
    else prog=$(app_program "$a"); mapfile -t list < <(app_files "$prog" | unique_files); fi
    if ((${#list[@]} == 0)); then printf '  %-9s %-14s not installed\n' "$a" "$prog"; continue; fi
    kb=$(du -cLk -- "${list[@]}" 2>/dev/null | tail -n1 | cut -f1) pct=''
    if command -v fincore >/dev/null; then
      res=$(fincore -nb -o RES -- "${list[@]}" 2>/dev/null | awk '{s+=$1} END {print int(s/1024)}')
      pct=", $(( kb ? res * 100 / kb : 0 ))% in RAM"
    fi
    h=''; helper_alive "$prog" && h=", server mode running"
    printf '  %-9s %-14s %d MB%s%s\n' "$a" "$prog" $((kb / 1024)) "$pct" "$h"
  done
  echo "  Config: $conf"
}

cmd=${1:-status}; shift || true
case $cmd in
  daemon) daemon "$@" ;;
  status) status ;;
  now) warm_round; tail -n1 "$st/warm.log" ;;
  off) switch 0 ;;
  on) switch 1 ;;
  toggle) load_conf; if (( ENABLED )); then switch 0; else switch 1; fi ;;
  --edit|edit) load_conf; exec tux-term --class tux-float -e "${EDITOR:-nano}" "$conf" ;;
  -h|--help|help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "tux-warm: unknown command $cmd (try --help)" >&2; exit 2 ;;
esac
