<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1792921976998965-1</unique-id>
	<command>tux-term --working-directory %f</command>
	<description>Open a terminal in this folder</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>document-send</icon>
	<name>Move the latest file here</name>
	<submenu></submenu>
	<unique-id>1792921976998965-2</unique-id>
	<command>tux-move-latest %f</command>
	<description>Move your newest download, screenshot or recording into this folder</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>drive-harddisk</icon>
	<name>Drive space</name>
	<submenu></submenu>
	<unique-id>1792921976998965-3</unique-id>
	<command>tux-drives space --menu</command>
	<description>Used and free space of every drive; pick one to open it</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>audio-volume-muted</icon>
	<name>Remove audio</name>
	<submenu>Utilities</submenu>
	<unique-id>1792921976998965-4</unique-id>
	<command>tux-strip-audio %F</command>
	<description>Save a copy without sound, "name (no audio).ext", next to the original</description>
	<range></range>
	<patterns>*</patterns>
	<video-files/>
</action>
<action>
	<icon>audio-x-generic</icon>
	<name>Extract audio</name>
	<submenu>Utilities</submenu>
	<unique-id>1792921976998965-6</unique-id>
	<command>tux-extract-audio %F</command>
	<description>Save the sound as an audio file, "name (audio).m4a", next to the original</description>
	<range></range>
	<patterns>*</patterns>
	<video-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as wallpaper</name>
	<submenu></submenu>
	<unique-id>1792921976998965-5</unique-id>
	<command>tux-wallpaper set %f</command>
	<description>Use this image as the desktop wallpaper, and its colours as the theme</description>
	<range>1-1</range>
	<patterns>*.jpg;*.jpeg;*.png;*.webp;*.JPG;*.JPEG;*.PNG;*.WEBP</patterns>
	<image-files/>
</action>
<action>
	<icon>tag</icon>
	<name>Add tag…</name>
	<submenu>Tags</submenu>
	<unique-id>1792921976998965-7</unique-id>
	<command>tux-tag add %F</command>
	<description>Tag these with one of your tags, or type a new tag name</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>edit-clear</icon>
	<name>Remove tag…</name>
	<submenu>Tags</submenu>
	<unique-id>1792921976998965-8</unique-id>
	<command>tux-tag remove %F</command>
	<description>Take a tag off these; the files stay</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>preferences-other</icon>
	<name>Manage tags…</name>
	<submenu>Tags</submenu>
	<unique-id>1792921976998965-9</unique-id>
	<command>tux-tag manage</command>
	<description>Rename a tag, change its colour or delete it</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>go-jump</icon>
	<name>Go to original location</name>
	<submenu>Tags</submenu>
	<unique-id>1792921976998965-10</unique-id>
	<command>tux-tag goto %f</command>
	<description>Leave ~/Tags: show this folder (or the folder this file is in) where it really is</description>
	<range>1-1</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
</actions>
