# tuxcraft dunst (from debi3n). Colours + font: dunstrc.d/10-theme.conf (generated by tux-theme).
[global]
    monitor = 0
    follow = mouse
    width = (280, 420)
    height = (0, 220)
    origin = top-right
    offset = (16, 48)
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    gap_size = 6
    corner_radius = 0
    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    stack_duplicates = true
    show_indicators = yes
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    idle_threshold = 120
    sticky_history = yes
    history_length = 30
    dmenu = tux-menu dunst
    browser = /usr/bin/xdg-open

[urgency_low]
    timeout = 4
[urgency_normal]
    timeout = 6
[urgency_critical]
    timeout = 0
