# tuxcraft i3 config (X11)
#   Shared keys/rules: ~/.config/tuxcraft/wm/common.conf
#   Colours + font:    ~/.config/i3/theme.conf (generated by tux-theme)
#   Your own tweaks:   ~/.config/i3/local.d/*.conf (never overwritten)

set $mod Mod4
set $alt Mod1
set $term alacritty
set $menu rofi -show drun -show-icons
set $windows rofi -show window -show-icons
set $lock tux-lock
set $clip tux-clip
set $files_gui thunar

include ~/.config/i3/theme.conf
include ~/.config/tuxcraft/wm/common.conf

tiling_drag modifier titlebar
bindsym $mod+Shift+r restart
#: Super+Shift+Q          Kill a frozen window by clicking it (xkill)
bindsym $mod+Shift+q exec --no-startup-id xkill

# ---- window rules (X11 classes)
for_window [class="^tux-float$"] floating enable, resize set 1100 700, move position center
for_window [class="^tux-float-big$"] floating enable, resize set 1400 860, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="mpv"] floating enable, resize set 1280 720, move position center
for_window [class="imv"] floating enable, move position center
for_window [class="feh"] floating enable, resize set 1280 720, move position center
for_window [class="(?i)pavucontrol|blueman-manager|nm-connection-editor|arandr|qalculate"] floating enable, move position center
for_window [class="copyq"] floating enable, sticky enable, border none, resize set 600 600, move position center
for_window [class="^webapp-.*"] floating enable, resize set 1280 720, move position center
for_window [title=".*\.exe$"] floating enable, move position center
for_window [title="Webcam Preview"] floating enable, sticky enable, border pixel 1
for_window [class="KeePassXC"] floating enable

# ---- workspace assignments (from debi3n)
assign [class="(?i)firefox|chromium|brave"] workspace number 2
assign [class="(?i)steam|lutris"] workspace number 5
assign [class="(?i)resolve|kdenlive"] workspace number 4
assign [class="qBittorrent"] workspace number 8

exec --no-startup-id tux-autostart i3

include ~/.config/i3/local.d/*.conf
