# tuxcraft sway config (Wayland) — same keys and look as the i3 session.
#   Shared keys/rules: ~/.config/tuxcraft/wm/common.conf
#   Colours + font:    ~/.config/sway/theme.conf (generated by tux-theme)
#   Keyboard/touchpad: ~/.config/sway/input.conf
#   Monitors:          kanshi (~/.config/kanshi/config) or `swaymsg -t get_outputs`
#   Your own tweaks:   ~/.config/sway/local.d/*.conf (never overwritten)

set $mod Mod4
set $alt Mod1
set $term alacritty
set $menu fuzzel
set $windows tux-windows
set $lock tux-lock
set $clip tux-clip
set $files_gui nemo

include ~/.config/sway/theme.conf
include ~/.config/sway/input.conf
include ~/.config/tuxcraft/wm/common.conf

tiling_drag enable
xwayland enable
bindsym $mod+Shift+r reload

# ---- window rules (native Wayland app_id + XWayland class)
for_window [app_id="^tux-float$"] floating enable, resize set 1100 700, move position center
for_window [app_id="^tux-float-big$"] floating enable, resize set 1400 860, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [shell="xdg_shell" title="^(Open|Save).*"] floating enable
for_window [app_id="mpv"] floating enable, resize set 1280 720, move position center
for_window [app_id="imv"] floating enable, move position center
for_window [app_id="(?i)pavucontrol|blueman-manager|nm-connection-editor|qalculate"] floating enable
for_window [app_id="^webapp-.*"] floating enable, resize set 1280 720, move position center
for_window [class="^webapp-.*"] floating enable, resize set 1280 720, move position center
for_window [title=".*\.exe$"] floating enable
for_window [app_id="org.keepassxc.KeePassXC"] floating enable

assign [app_id="(?i)firefox|chromium|brave"] workspace number 2
assign [class="(?i)steam|lutris"] workspace number 5
assign [app_id="org.qbittorrent.qBittorrent"] workspace number 8

exec tux-autostart sway

include ~/.config/sway/local.d/*.conf
