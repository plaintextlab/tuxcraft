! Generated by tux-theme ({{theme_name}})
Xft.dpi: 96
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xcursor.theme: {{cursor_theme}}
Xcursor.size: 24
*.background: {{bg}}
*.foreground: {{fg}}
*.cursorColor: {{accent}}
*.color0: {{color0}}
*.color1: {{color1}}
*.color2: {{color2}}
*.color3: {{color3}}
*.color4: {{color4}}
*.color5: {{color5}}
*.color6: {{color6}}
*.color7: {{color7}}
*.color8: {{color8}}
*.color9: {{color9}}
*.color10: {{color10}}
*.color11: {{color11}}
*.color12: {{color12}}
*.color13: {{color13}}
*.color14: {{color14}}
*.color15: {{color15}}
! dwm session (tux-dwm): her colour layout. Bar = background, text = the light foreground,
! unselected tags and the focused window 1px border = muted (both use selbordercolor, as in her
! build). The bar and dmenu use the terminal (monospace) font, as hers do: it also has more
! symbols (● and the like) than most UI fonts.
dwm.normbgcolor: {{bg}}
dwm.normbordercolor: {{bg}}
dwm.normfgcolor: {{fg}}
dwm.selbgcolor: {{accent}}
dwm.selfgcolor: {{bg}}
dwm.selbordercolor: {{muted}}
dwm.font: {{term_font}}:size={{font_size}}
dwm.iconfont: Symbols Nerd Font:size={{font_size}}
dmenu.font: {{term_font}}:size={{font_size}}
dmenu.background: {{bg}}
dmenu.foreground: {{fg}}
dmenu.selbackground: {{accent}}
dmenu.selforeground: {{accent_fg}}
! nsxiv (the wallpaper thumbnails, tux-wallpaper --menu)
Nsxiv.window.background: {{bg}}
Nsxiv.window.foreground: {{fg}}
Nsxiv.mark.foreground: {{accent}}
Nsxiv.bar.font: {{term_font}}:size={{font_size}}
