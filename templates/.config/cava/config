; Generated by tux-theme ({{theme_name}}). cava: the audio visualizer (Super+Shift+M).
; Keys inside cava: up/down sensitivity, left/right bar width, f/b cycle colours, r reload, q quit.
[general]
framerate = 60
autosens = 1
bar_width = 2
bar_spacing = 1

[input]
; Whatever PipeWire plays (through pipewire-pulse): mpd, browsers, games.
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = default
gradient = 1
gradient_count = 3
gradient_color_1 = '{{accent}}'
gradient_color_2 = '{{magenta}}'
gradient_color_3 = '{{red}}'

[smoothing]
noise_reduction = 77
