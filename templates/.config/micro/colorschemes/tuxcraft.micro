# Generated by tux-theme ({{theme_name}})
color-link default "{{fg}},{{bg}}"
color-link comment "{{muted}}"
color-link identifier "{{blue}}"
color-link constant "{{magenta}}"
color-link constant.string "{{green}}"
color-link constant.string.char "{{green}}"
color-link statement "{{red}}"
color-link symbol.operator "{{orange}}"
color-link preproc "{{cyan}}"
color-link type "{{yellow}}"
color-link special "{{orange}}"
color-link underlined "underline {{blue}}"
color-link error "bold {{red}}"
color-link todo "bold {{yellow}}"
color-link hlsearch "{{bg}},{{yellow}}"
color-link statusline "{{fg}},{{bg_alt}}"
color-link tabbar "{{fg}},{{bg_alt}}"
color-link indent-char "{{bg_hl}}"
color-link line-number "{{muted}},{{bg}}"
color-link current-line-number "{{accent}},{{bg}}"
color-link gutter-error "{{red}}"
color-link gutter-warning "{{yellow}}"
color-link cursor-line "{{bg_alt}}"
color-link color-column "{{bg_alt}}"
color-link selection "{{fg}},{{bg_hl}}"
color-link diff-added "{{green}}"
color-link diff-modified "{{yellow}}"
color-link diff-deleted "{{red}}"
color-link match-brace "{{bg}},{{accent}}"
