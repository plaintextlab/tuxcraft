/* Generated by tux-theme ({{theme_name}}) — based on the debi3n gruvbox.rasi layout */
configuration { icon-theme: "{{icon_theme}}"; }
* {
    font:            "{{font}} {{font_size}}";
    bg:              {{bg_dark}}f2;
    bg-alt:          {{bg}};
    bg-sel:          {{bg_hl}};
    fg:              {{fg}};
    fg-dim:          {{muted}};
    accent:          {{accent}};
    accent-fg:       {{accent_fg}};
    urgent:          {{red}};
    background-color: transparent;
    text-color:      @fg;
}
window      { width: 760px; border: 2px; border-color: @accent; background-color: @bg; padding: 16px; }
mainbox     { spacing: 12px; children: [ inputbar, message, listview, mode-switcher ]; }
inputbar    { children: [ prompt, entry ]; spacing: 10px; }
prompt      { background-color: @accent; text-color: @accent-fg; padding: 6px 10px; }
entry       { padding: 6px; placeholder: "type to search"; placeholder-color: @fg-dim; }
message     { background-color: @bg-alt; padding: 6px; }
textbox     { text-color: @fg; }
listview    { lines: 10; columns: 1; fixed-height: false; scrollbar: false; spacing: 2px; }
element     { padding: 6px 8px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @bg-sel; text-color: @accent; }
element normal.urgent, element selected.urgent { text-color: @urgent; }
element normal.active, element selected.active { text-color: @accent; }
element-icon { size: 1.3em; background-color: transparent; }
element-text { text-color: inherit; background-color: transparent; vertical-align: 0.5; }
mode-switcher { spacing: 0; }
button      { padding: 8px; background-color: @bg-alt; text-color: @fg-dim; }
button selected { background-color: @bg-sel; text-color: @accent; }
