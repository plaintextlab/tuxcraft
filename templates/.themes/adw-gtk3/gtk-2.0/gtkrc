# Generated by tux-theme ({{theme_name}}). adw-gtk3 has no GTK 2 version, so GTK 2 apps (Steam's
# tray menu and window, old tools) fell back to the grey built-in look. This is a plain GTK 2
# theme under the same name (GTK 2 looks in ~/.themes first; GTK 3 still uses the real
# adw-gtk3), in the palette's colours. No theme engine: works in any runtime, Steam's included.
gtk-color-scheme = "bg_color:{{bg}}\nfg_color:{{fg}}\nbase_color:{{bg_dark}}\ntext_color:{{fg}}\nselected_bg_color:{{accent}}\nselected_fg_color:{{accent_fg}}\ntooltip_bg_color:{{bg_alt}}\ntooltip_fg_color:{{fg}}"
gtk-menu-popup-delay = 0
gtk-button-images = 0
gtk-menu-images = 1

style "tux-default" {
  xthickness = 1
  ythickness = 1
  bg[NORMAL]        = @bg_color
  bg[PRELIGHT]      = "{{bg_hl}}"
  bg[ACTIVE]        = "{{bg_alt}}"
  bg[SELECTED]      = @selected_bg_color
  bg[INSENSITIVE]   = @bg_color
  fg[NORMAL]        = @fg_color
  fg[PRELIGHT]      = @fg_color
  fg[ACTIVE]        = @fg_color
  fg[SELECTED]      = @selected_fg_color
  fg[INSENSITIVE]   = "{{muted}}"
  base[NORMAL]      = @base_color
  base[PRELIGHT]    = "{{bg_alt}}"
  base[ACTIVE]      = @selected_bg_color
  base[SELECTED]    = @selected_bg_color
  base[INSENSITIVE] = @bg_color
  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @text_color
  text[ACTIVE]      = @selected_fg_color
  text[SELECTED]    = @selected_fg_color
  text[INSENSITIVE] = "{{muted}}"
  GtkWidget::focus-line-width = 0
  GtkMenuItem::selected-shadow-type = GTK_SHADOW_NONE
  GtkButton::default-border = { 0, 0, 0, 0 }
}
# Menus (tray icon menus): the bar's look, the accent on the item under the pointer.
style "tux-menu" {
  xthickness = 1
  ythickness = 4
  bg[NORMAL] = "{{bg_dark}}"
  fg[NORMAL] = @fg_color
}
style "tux-menuitem" {
  xthickness = 6
  ythickness = 4
  bg[PRELIGHT] = @selected_bg_color
  fg[PRELIGHT] = @selected_fg_color
  text[PRELIGHT] = @selected_fg_color
  fg[INSENSITIVE] = "{{muted}}"
}
style "tux-separator" {
  xthickness = 1
  ythickness = 1
  bg[NORMAL] = "{{bg_hl}}"
}
style "tux-tooltip" {
  xthickness = 6
  ythickness = 4
  bg[NORMAL] = @tooltip_bg_color
  fg[NORMAL] = @tooltip_fg_color
}
class "GtkWidget" style "tux-default"
widget_class "*<GtkMenu>*" style "tux-menu"
widget_class "*<GtkMenuItem>*" style "tux-menuitem"
widget_class "*<GtkSeparatorMenuItem>*" style "tux-separator"
widget "gtk-tooltip*" style "tux-tooltip"
